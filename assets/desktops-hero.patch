diff --git a/public/hausfold.css b/public/hausfold.css
index 9684693..50ae3f2 100644
--- a/public/hausfold.css
+++ b/public/hausfold.css
@@ -529,6 +529,24 @@ body {
   grid-column: 1 / -1;
 }
 
+/* A frame holding a real capture stops being a placeholder. The picture
+   brings its own aspect ratio — the 14" panel this was shot on is 1.54:1,
+   not 16:10 — and forcing either of the ratios above with object-fit:cover
+   would shave the top and bottom bars off, which are two of the things the
+   shot exists to show. So the <img> sets the height and the frame follows
+   it. Declared after .shot--wide so it wins on equal specificity. */
+.shot--filled {
+  aspect-ratio: auto;
+  border-style: solid;
+  padding: 0;
+  overflow: hidden;
+}
+
+.shot--filled img {
+  height: auto;
+  object-fit: fill;
+}
+
 /* --- sections ------------------------------------------------------ */
 
