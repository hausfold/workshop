---
import ProductLanding from '../layouts/ProductLanding.astro';

const features = [
  {
    category: 'collect',
    title: 'Drop nearly anything',
    blurb:
      'Files, folders, Photos exports, Safari images, links, and text all land in the same shelf.',
    accent: '#b5bff8',
  },
  {
    category: 'carry',
    title: 'Take one or take the lot',
    blurb:
      'Drag a single tile back out, or grab the stack and carry every finished item somewhere else at once.',
    accent: '#9be0d5',
  },
  {
    category: 'safety',
    title: 'Your originals stay yours',
    blurb:
      'Perch stages private copies. It never moves, renames, edits, or deletes the things you dropped in.',
    accent: '#f2c4e5',
  },
];
---

<ProductLanding
  product="perch"
  accent="#b5bff8"
  accentHover="#c8cff9"
  logo="/logos/perch.png"
  eyebrow="native · temporary · dependable · macos"
  titleLead="A file shelf"
  titleAccent="in your notch."
  lede="Drop things now. Drag them somewhere else when you are ready."
  description="Perch is a native macOS temporary file shelf that grows out of the MacBook notch. Collect files, folders, images, links, and text, then drag them somewhere else."
  socialImage="https://nebelhaus.com/social/perch-og.png"
  install="brew install --cask nebelhaus/tap/perch"
  installMarkup={{
    command: 'brew install',
    flag: '--cask',
    formula: 'nebelhaus/tap/perch',
  }}
  standaloneCopy="This adds only Perch.app to your Mac. No Nix, Dock icon, Accessibility, Input Monitoring, or Screen Recording permission."
  riceCopy="Perch has a room in nebelhaus too. Enable nebelhaus.perch when you want the shelf installed with the rest of the rice."
  riceHref="/start/what-is-nebelhaus/"
  guideHref="https://github.com/nebelhaus/perch#readme"
  repoHref="https://github.com/nebelhaus/perch"
  featuresLabel="a temporary stop between places"
  featuresTitle="Drop. Hold. Carry on."
  featuresCopy="Perch stays out of the way until something needs somewhere to wait."
  features={features}
  closerStatus="copy-only"
  closerTitle="Temporary should still be dependable."
  closerCopy="Every accepted item finishes copying into Perch's private shelf before it appears. Relaunching recovers the shelf, and dragging out advertises copy only."
  closerPrimaryLabel="How Perch handles files"
  closerPrimaryHref="https://github.com/nebelhaus/perch#storage-and-privacy"
/>
