  /* The 14s clock, in seconds: summon at 0, recency list up by 0.2. Typing
     starts at 2.2 — s, l, a — and at 2.62 the list snaps to the Slack
     results ON the same frame the recency palette drops (disjoint keyframes,
     no crossfade); c and k land at 2.7 and 2.85. ↵ at 4.3, closed by 4.8.
     Summon 2 at 5.6 types "claude" by 6.6, rows blooming mid-word; ↵ at 8,
     gone by 8.6. Summon 3 at 9.2 types the conversion by 10.7, the answer
     card pops at 10.8; ↵ copies at 12.4, gone by 13. The last second is
     empty desktop so the loop can breathe. */
  @keyframes recency-summons {
    0% {
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.97);
    }
    1.4%, 18.7% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    18.75%, 100% {
      opacity: 0;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @keyframes slack-appears {
    0%, 18.65% {
      opacity: 0;
      transform: translate(-50%, 0) scale(1);
    }
    18.7%, 32.9% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    34.3%, 100% {
      opacity: 0;
      transform: translate(-50%, -4px) scale(0.99);
    }
  }

  @keyframes palette-summons {
    0%, 40% {
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.97);
    }
    41.4%, 60% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    61.4%, 100% {
      opacity: 0;
      transform: translate(-50%, -4px) scale(0.99);
    }
  }

  @keyframes convert-summons {
    0%, 65.7% {
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.97);
    }
    67.1%, 91.4% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    92.9%, 100% {
      opacity: 0;
      transform: translate(-50%, -4px) scale(0.99);
    }
  }

