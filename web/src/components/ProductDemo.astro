---
interface Props {
  product: 'pounce' | 'perch';
}

const { product } = Astro.props;

const content = {
  pounce: {
    label: '⌘ space to done',
    title: 'Thought to action, before the thought leaves.',
    copy: 'Summon it, type what you mean, and get back to the work. No dashboard. No ceremony.',
  },
  perch: {
    label: 'the notch earns its keep',
    title: 'A temporary shelf that moves at your speed.',
    copy: 'Flick something up, keep working, then carry it where it belongs. The original never moves.',
  },
}[product];
---

<section class="product-demo" aria-labelledby={`${product}-demo-title`} data-product-demo={product}>
  <div class="demo-viewport">
    <div class="demo-stage">
      <figure class="macbook">
        <div class="macbook-render">
          <div class="macbook-screen">
            {
              product === 'pounce' ? (
                <div
                  class="pounce-demo"
                  role="img"
                  aria-label="Pounce summoned over a desktop: a recent-items list of apps, built-in commands, and a System Settings deep link filters into Slack search results as you type, a second summon finds the Claude app, and a third converts 200 CAD to USD inline"
                >
                  <div class="desktop-bar" aria-hidden="true">
                    <span class="bar-group">
                      <i class="pill accent">1</i>
                      <i class="pill">pounce</i>
                    </span>
                    <span class="bar-group">
                      <i class="pill">15%</i>
                      <i class="pill">25°</i>
                      <i class="pill">Wed Jul 29&nbsp;&nbsp;9:41</i>
                    </span>
                  </div>
                  <div class="pounce-palette scene-recency" aria-hidden="true">
                    <div class="palette-field">
                      <i class="glass" />
                      <b>sla</b>
                      <i class="caret" />
                    </div>
                    <div class="palette-rows">
                      <div class="palette-row selected">
                        <img class="row-icon real" src="/media/app-icons/zen.png" alt="" loading="lazy" decoding="async" />
                        <b>Zen</b>
                        <em>Application</em>
                      </div>
                      <div class="palette-row">
                        <img class="row-icon real flush" src="/media/app-icons/perch.png" alt="" loading="lazy" decoding="async" />
                        <b>Perch</b>
                        <em>Application</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-clip" />
                        <b>Clipboard History</b>
                        <em>Browse &amp; paste recent copies</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-search" />
                        <b>Find Files</b>
                        <em>Search files &amp; folders by name</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-slider" />
                        <b>Displays</b>
                        <em>System Settings</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-ring" />
                        <b>Emoji</b>
                        <em>Search &amp; paste emoji</em>
                      </div>
                    </div>
                  </div>
                  <div class="pounce-palette scene-slack" aria-hidden="true">
                    <div class="palette-field">
                      <i class="glass" />
                      <b>slack</b>
                      <i class="caret" />
                    </div>
                    <div class="palette-rows">
                      <div class="palette-row selected">
                        <img class="row-icon real" src="/media/app-icons/slack.png" alt="" loading="lazy" decoding="async" />
                        <b>Slack</b>
                        <em>Application</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-moon" />
                        <b>Toggle Hush</b>
                        <em>Focus/DND + Slack status, one switch</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-tray" />
                        <b>Install App</b>
                        <em>Install from Homebrew, the Mac App Store, or Nixpkgs</em>
                      </div>
                    </div>
                  </div>
                  <div class="pounce-palette scene-claude" aria-hidden="true">
                    <div class="palette-field">
                      <i class="glass" />
                      <b>claude</b>
                      <i class="caret" />
                    </div>
                    <div class="palette-rows">
                      <div class="palette-row selected">
                        <img class="row-icon real" src="/media/app-icons/claude.png" alt="" loading="lazy" decoding="async" />
                        <b>Claude</b>
                        <em>Application</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-link" />
                        <b>Links</b>
                        <em>Open a URL from the focused pane's Claude transcript</em>
                      </div>
                    </div>
                  </div>
                  <div class="pounce-palette scene-convert" aria-hidden="true">
                    <div class="palette-field">
                      <i class="glass" />
                      <b>200 cad to usd</b>
                      <i class="caret" />
                    </div>
                    <div class="palette-rows">
                      <div class="answer-well">
                        <div class="palette-row answer">
                          <span class="row-icon mark-coin">$</span>
                          <b>141.77 USD</b>
                          <em>200 CAD → US Dollar · ECB 2026-07-28</em>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ) : (
                <div
                  class="perch-demo"
                  role="img"
                  aria-label="Perch ferrying a QA session through the notch shelf: ⇧⌘3 captures the pounce landing page and the floating thumbnail is dragged into the shelf, which grows out of the notch and tucks away whenever the cursor leaves; clicking Download for macOS lands Pounce in the Dock's Downloads stack, which fans open so the download can be dragged in too; then Finder opens and both drag out one at a time — the screenshot into the shots folder, Pounce into Applications — copy-only throughout, originals untouched"
                >
                  <div class="desktop-menu" aria-hidden="true">
                    <span>⌁ &nbsp; Finder &nbsp; File &nbsp; Edit &nbsp; View</span>
                    <span>◔ &nbsp; 100% &nbsp; Wed Jul 29 &nbsp; 9:41</span>
                  </div>
                  <div class="desktop-window win-browser" aria-hidden="true">
                    <header>
                      <i /><i /><i />
                      <span class="url-pill">nebelhaus.com/pounce</span>
                    </header>
                    <div class="browser-page">
                      <p class="bp-eyebrow">native · keyboard-first · local-first</p>
                      <p class="bp-title">The command palette<br /><b>with claws.</b></p>
                      <span class="bp-lede" />
                      <span class="bp-lede short" />
                      <span class="bp-cta">Download for macOS</span>
                    </div>
                  </div>
                  <div class="desktop-window win-finder" aria-hidden="true">
                    <header>
                      <i /><i /><i />
                      <span class="flip win-title">
                        <i class="ti-shots">shots</i>
                        <i class="ti-apps">Applications</i>
                      </span>
                    </header>
                    <aside>
                      <b>Favorites</b>
                      <span>⌂ &nbsp; AirDrop</span>
                      <span class="fav-apps">▣ &nbsp; Applications</span>
                      <span class="fav-shots">◫ &nbsp; shots</span>
                      <span>⌁ &nbsp; Downloads</span>
                    </aside>
                    <div class="desktop-main main-shots">
                      <div class="file-card card-shot"><i class="shot-mini mini-browser" /><span>landing.png</span></div>
                    </div>
                    <div class="desktop-main main-apps">
                      <div class="file-card">
                        <img class="app-ico" src="/media/app-icons/zen.png" alt="" loading="lazy" decoding="async" />
                        <span>Zen</span>
                      </div>
                      <div class="file-card">
                        <img class="app-ico" src="/media/app-icons/slack.png" alt="" loading="lazy" decoding="async" />
                        <span>Slack</span>
                      </div>
                      <div class="file-card card-app">
                        <img class="app-ico" src="/media/app-icons/pounce.png" alt="" loading="lazy" decoding="async" />
                        <span>Pounce</span>
                      </div>
                    </div>
                  </div>
                  <div class="dock" aria-hidden="true">
                    <img src="/media/app-icons/zen.png" alt="" loading="lazy" decoding="async" />
                    <img src="/media/app-icons/claude.png" alt="" loading="lazy" decoding="async" />
                    <img src="/media/app-icons/slack.png" alt="" loading="lazy" decoding="async" />
                    <i class="sep" />
                    <span class="stack">↓<b class="dl-badge">1</b></span>
                  </div>
                  <div class="dl-fan" aria-hidden="true">
                    <img src="/media/app-icons/pounce.png" alt="" loading="lazy" decoding="async" />
                    <em>Pounce.zip</em>
                  </div>
                  <div class="perch-shelf" aria-hidden="true">
                    <header>
                      <span class="flip shelf-state">
                        <span class="st-drop">drop to stash</span>
                        <span class="st-one">1 thing waiting</span>
                        <span class="st-two">2 things waiting</span>
                        <span class="st-empty">nothing waiting</span>
                      </span>
                      <b>copy-only</b>
                    </header>
                    <div class="shelf-items">
                      <div class="shelf-item sh-a"><i class="shot-mini mini-browser" /><span>landing.png</span></div>
                      <div class="shelf-item sh-b">
                        <img class="app-ico" src="/media/app-icons/pounce.png" alt="" loading="lazy" decoding="async" />
                        <span>Pounce.zip</span>
                      </div>
                    </div>
                  </div>
                  <i class="shutter" aria-hidden="true" />
                  <i class="key-cast kc-shot" aria-hidden="true">⇧⌘3</i>
                  <span class="thumb thumb-a" aria-hidden="true"><i class="shot-mini mini-browser" /></span>
                  <i class="drag-ghost g-shot-in" aria-hidden="true"><i class="shot-mini mini-browser" /></i>
                  <i class="drag-ghost g-dl-in" aria-hidden="true">
                    <img class="app-ico" src="/media/app-icons/pounce.png" alt="" loading="lazy" decoding="async" />
                  </i>
                  <i class="drag-ghost g-shot-out" aria-hidden="true">
                    <i class="shot-mini mini-browser" />
                    <em class="copy-pill">copy</em>
                  </i>
                  <i class="drag-ghost g-dl-out" aria-hidden="true">
                    <img class="app-ico" src="/media/app-icons/pounce.png" alt="" loading="lazy" decoding="async" />
                    <em class="copy-pill">copy</em>
                  </i>
                  <i class="cursor" aria-hidden="true" />
                </div>
              )
            }
          </div>
          <img
            class="macbook-frame"
            src="/media/macbook-pro-orthographic.svg"
            alt=""
            width="1648"
            height="1158"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </div>
      </figure>
    </div>
  </div>

  <div class="demo-heading">
    <div>
      <p class="demo-label">{content.label}</p>
      <h2 id={`${product}-demo-title`}>{content.title}</h2>
    </div>
    <p>{content.copy}</p>
  </div>
</section>

<style>
  .product-demo {
    margin: 0 0 6.5rem;
  }

  /* The device leads; this reads as its caption, so it sits below and a size
     down from the hero's h1. */
  .demo-heading {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: end;
    gap: 3rem;
    margin: 2.2rem 0 0;
  }

  .demo-label {
    margin: 0 0 0.7rem;
    color: var(--product-accent);
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.055em;
    text-transform: lowercase;
  }

  .demo-heading h2 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(1.55rem, 3.2vw, 2.2rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .demo-heading > p {
    max-width: 470px;
    margin: 0 0 0.25rem;
    color: var(--subtext0);
    font-size: 0.94rem;
  }

  .demo-viewport {
    padding: 0.5rem 0 0.9rem;
    overflow: clip;
  }

  .demo-stage {
    display: grid;
    width: 100%;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
  }

  .macbook {
    position: relative;
    width: min(960px, calc(100% - 1rem));
    margin: 0;
  }

  /* Grounding on a near-black page: a shadow would vanish, so the laptop
     sits in a faint pool of its own accent light instead. */
  .macbook::after {
    position: absolute;
    right: 7%;
    bottom: -2.6%;
    left: 7%;
    height: 5%;
    background: radial-gradient(50% 100% at 50% 0, color-mix(in srgb, var(--product-accent, var(--mauve)) 17%, transparent), transparent 74%);
    content: '';
  }

  /* Geometry mirrors macbook-pro-orthographic.svg's 1648 × 1158 viewBox:
     the panel cutout is x 58–1590, y 34–1029. */
  .macbook-render {
    position: relative;
    aspect-ratio: 1648 / 1128;
    container-type: inline-size;
  }

  .macbook-screen {
    position: absolute;
    top: 3.014%;
    left: 3.519%;
    z-index: 1;
    width: 92.961%;
    height: 88.209%;
    overflow: hidden;
    background: var(--crust);
    border-radius: 1.96% 1.96% 0.52% 0.52%;
    isolation: isolate;
  }

  .macbook-frame {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Pounce's code-native preview: the real palette chrome, synthetic results. */
  .pounce-demo {
    display: grid;
    position: relative;
    width: 100%;
    height: 100%;
    align-content: start;
    overflow: hidden;
    background:
      radial-gradient(95% 72% at 50% 6%, color-mix(in srgb, var(--product-accent, var(--peach)) 6%, transparent), transparent 62%),
      radial-gradient(circle at 68% 78%, transparent 0 16%, color-mix(in srgb, var(--product-accent, var(--peach)) 16%, transparent) 16.1% 16.4%, transparent 16.5% 27%, color-mix(in srgb, var(--surface2) 34%, transparent) 27.1% 27.4%, transparent 27.5% 39%, color-mix(in srgb, var(--surface2) 44%, transparent) 39.1% 39.4%, transparent 39.5%),
      var(--crust);
    color: var(--text);
    font-family: var(--font);
    font-size: clamp(7px, 1.25cqw, 12px);
    text-align: left;
  }

  /* Sill, roughly: pills either side, not a macOS menu bar. */
  /* Sits clear of the bezel's inner edge and corner radius — flush against
     the top it reads as a collision with the frame. */
  .desktop-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 8%;
    padding: 1.6% 2.8% 0;
  }

  .bar-group {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .pill {
    padding: 0.32em 0.62em;
    background: color-mix(in srgb, var(--surface0) 78%, transparent);
    border-radius: 0.8em;
    color: var(--subtext0);
    font-family: var(--mono);
    font-size: 0.72em;
    font-style: normal;
    font-weight: 500;
    white-space: nowrap;
  }

  .pill.accent {
    background: color-mix(in srgb, var(--product-accent, var(--peach)) 24%, transparent);
    color: var(--product-accent, var(--peach));
  }

  /* One 14s clock, three summons. The first opens onto the recency list;
     typing "sla" filters it into the Slack results (a twin palette swapped
     in on the SAME frame — no fade overlap, or the stack visibly flashes)
     and the last two chars land after the swap, the way a live list chases
     the query. Then a fresh summon types "claude", and a third converts
     currency inline. */
  .pounce-palette {
    position: absolute;
    top: 19%;
    left: 50%;
    width: 62%;
    overflow: hidden;
    background: color-mix(in srgb, var(--crust) 96%, transparent);
    border: 1px solid var(--surface0);
    border-radius: 13px;
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translate(-50%, 0) scale(1);
  }

  .scene-recency {
    animation: recency-summons 14s ease-out infinite;
  }

  .scene-slack {
    animation: slack-appears 14s ease-out infinite;
  }

  .scene-claude {
    animation: palette-summons 14s ease-out infinite;
  }

  .scene-convert {
    animation: convert-summons 14s ease-out infinite;
  }

  .palette-field {
    display: flex;
    align-items: center;
    gap: 0.85em;
    padding: 1.5em 1.7em;
    border-bottom: 1px solid var(--surface0);
    font-family: var(--mono);
    font-size: 1.2em;
  }

  .palette-field .glass {
    position: relative;
    width: 0.92em;
    height: 0.92em;
    flex: 0 0 auto;
    border: 1.5px solid var(--overlay0);
    border-radius: 50%;
  }

  .palette-field .glass::after {
    position: absolute;
    right: -0.3em;
    bottom: -0.14em;
    width: 0.44em;
    height: 1.5px;
    background: var(--overlay0);
    border-radius: 1px;
    content: '';
    transform: rotate(45deg);
  }

  .palette-field b {
    display: inline-block;
    width: 0;
    overflow: hidden;
    font-weight: 400;
    white-space: nowrap;
  }

  .scene-recency .palette-field b {
    animation: types-sla 14s steps(1, end) infinite;
  }

  .scene-slack .palette-field b {
    animation: types-slack 14s steps(1, end) infinite;
  }

  .scene-claude .palette-field b {
    animation: types-claude 14s steps(1, end) infinite;
  }

  .scene-convert .palette-field b {
    animation: types-convert 14s linear infinite;
  }

  .palette-field .caret {
    width: 2px;
    height: 1.25em;
    margin-left: -0.5em;
    background: var(--product-accent, var(--mauve));
    animation: caret-blinks 1.06s steps(2, jump-none) infinite;
  }

  .palette-rows {
    padding: 0.55em;
  }

  .palette-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9em;
    padding: 0.62em 1.1em;
    border-radius: 8px;
    opacity: 0;
  }

  .palette-row:nth-child(2) {
    animation-delay: 0.05s;
  }

  .palette-row:nth-child(3) {
    animation-delay: 0.1s;
  }

  .palette-row:nth-child(4) {
    animation-delay: 0.15s;
  }

  .palette-row:nth-child(5) {
    animation-delay: 0.2s;
  }

  .palette-row:nth-child(6) {
    animation-delay: 0.25s;
  }

  .scene-recency .palette-row {
    animation: rows-bloom 14s ease-out infinite;
  }

  .scene-slack .palette-row {
    animation: rows-snap 14s linear infinite;
  }

  .scene-claude .palette-row {
    animation: rows-bloom-late 14s ease-out infinite;
  }

  .scene-convert .palette-row {
    animation: answer-pops 14s ease-out infinite;
  }

  .palette-row.selected,
  .palette-row.answer {
    background: color-mix(in srgb, var(--product-accent, var(--mauve)) 17%, transparent);
  }

  /* The ↵ reads as a brightness blip on the selected row, just before close. */
  .scene-slack .palette-row.selected {
    animation:
      rows-snap 14s linear infinite,
      actioned-a 14s linear infinite;
  }

  .scene-claude .palette-row.selected {
    animation:
      rows-bloom-late 14s ease-out infinite,
      actioned-b 14s linear infinite;
  }

  .scene-convert .palette-row.answer {
    animation:
      answer-pops 14s ease-out infinite,
      actioned-c 14s linear infinite;
  }

  /* The calculator answer is a card, not a row: big value, provenance under
     it, the coin spanning both lines. */
  .palette-row.answer {
    grid-template-columns: auto 1fr;
    gap: 0.35em 1em;
    padding: 0.9em 1.1em;
  }

  .palette-row.answer .row-icon {
    grid-row: 1 / 3;
    align-self: center;
  }

  .palette-row.answer b {
    font-size: 1.65em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .palette-row.answer em {
    color: var(--subtext0);
  }

  .palette-row b,
  .palette-row em {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-row b {
    font-size: 1.06em;
    font-weight: 600;
  }

  .palette-row em {
    color: var(--overlay1);
    font-size: 0.88em;
    font-style: normal;
  }

  .palette-row.selected em {
    color: var(--subtext0);
  }

  /* Built-in commands are drawn glyphs; the app rows show the apps' real
     icons (extracted from their bundles at 128px). */
  .row-icon {
    position: relative;
    width: 2em;
    height: 2em;
    background: var(--surface1);
    border-radius: 27%;
  }

  /* macOS icns art bakes the squircle + a ~10% transparent margin into the
     bitmap, so the box oversizes and pulls back in to keep the *visible*
     squircle at the 2em the drawn glyphs use. */
  .row-icon.real {
    width: 2.5em;
    height: 2.5em;
    margin: -0.25em;
    background: none;
    border-radius: 0;
  }

  /* Perch's icns is full-bleed (no baked margin) — no compensation needed. */
  .row-icon.real.flush {
    width: 2em;
    height: 2em;
    margin: 0;
  }

  /* System Settings as sliders: two rails, two knobs. */
  .row-icon.mark-slider {
    background:
      radial-gradient(circle 1.7px at 38% 38%, var(--overlay1) 97%, transparent),
      radial-gradient(circle 1.7px at 64% 62%, var(--overlay1) 97%, transparent),
      linear-gradient(var(--overlay1) 0 100%) 50% 38% / 44% 1.5px no-repeat,
      linear-gradient(var(--overlay1) 0 100%) 50% 62% / 44% 1.5px no-repeat,
      var(--surface1);
  }

  /* Clipboard: a board with its clip sitting proud of the top edge. */
  .row-icon.mark-clip::before {
    position: absolute;
    inset: 26% 30%;
    border: 1.5px solid var(--overlay1);
    border-radius: 2px;
    content: '';
  }

  .row-icon.mark-clip::after {
    position: absolute;
    top: 18%;
    left: 38%;
    width: 24%;
    height: 14%;
    background: var(--surface1);
    border: 1.5px solid var(--overlay1);
    border-radius: 2px;
    content: '';
  }

  /* Find Files: the same magnifier as the query field, in miniature. */
  .row-icon.mark-search::before {
    position: absolute;
    inset: 26% 36% 36% 26%;
    border: 1.5px solid var(--overlay1);
    border-radius: 50%;
    content: '';
  }

  .row-icon.mark-search::after {
    position: absolute;
    right: 24%;
    bottom: 27%;
    width: 20%;
    height: 1.5px;
    background: var(--overlay1);
    border-radius: 1px;
    content: '';
    transform: rotate(45deg);
  }

  /* A crescent for Hush: a moon disc with a bite of icon-background. */
  .row-icon.mark-moon {
    background:
      radial-gradient(circle at 62% 38%, var(--surface1) 0 24%, transparent 25%),
      radial-gradient(circle at 48% 52%, var(--overlay1) 0 27%, transparent 28%),
      var(--surface1);
  }

  /* Install App: an arrow dropping into a tray. */
  .row-icon.mark-tray::before {
    position: absolute;
    top: 24%;
    left: calc(50% - 0.75px);
    width: 1.5px;
    height: 26%;
    background: var(--overlay1);
    content: '';
  }

  .row-icon.mark-tray::after {
    position: absolute;
    inset: 52% 28% 26%;
    border: 1.5px solid var(--overlay1);
    border-top: none;
    border-radius: 0 0 3px 3px;
    content: '';
  }

  /* Links: two chain plates on the diagonal. */
  .row-icon.mark-link::before,
  .row-icon.mark-link::after {
    position: absolute;
    border: 1.5px solid var(--overlay1);
    border-radius: 40%;
    content: '';
    transform: rotate(-45deg);
  }

  .row-icon.mark-link::before {
    inset: 32% 40% 32% 16%;
  }

  .row-icon.mark-link::after {
    inset: 32% 16% 32% 40%;
  }

  /* The converter's coin: a $ in a ring on an accent chip. */
  .row-icon.mark-coin {
    display: grid;
    width: 2.6em;
    height: 2.6em;
    place-items: center;
    background: color-mix(in srgb, var(--product-accent, var(--mauve)) 26%, transparent);
    color: var(--product-accent, var(--mauve));
    font-size: 1em;
    font-weight: 650;
  }

  .row-icon.mark-coin::after {
    position: absolute;
    inset: 21%;
    border: 1.5px solid var(--product-accent, var(--mauve));
    border-radius: 50%;
    content: '';
  }

  .row-icon.mark-ring::after {
    position: absolute;
    inset: 30%;
    border: 1.5px solid var(--overlay1);
    border-radius: 50%;
    content: '';
  }

  /* No hint footer here — the list just ends, so it gets a touch more
     breathing room at the bottom than between rows. */
  .palette-rows {
    padding-bottom: 0.75em;
  }

  /* The converter opens as a bare input; the well under it holds no track
     until the query completes, then 0fr→1fr grows the palette around the
     answer (the row's padding is clipped by the well while collapsed). */
  .scene-convert .palette-rows {
    display: grid;
    grid-template-rows: 0fr;
    padding-block: 0;
    animation: answer-grows 14s ease-out infinite;
  }

  .scene-convert .palette-field {
    border-bottom-color: transparent;
    animation: field-divides 14s linear infinite;
  }

  .answer-well {
    min-height: 0;
    overflow: hidden;
  }

  /* Stacked text swap: every child shares the cell, opacity picks one. */
  .flip {
    display: grid;
  }

  .flip > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .flip i {
    font-style: normal;
  }

  time.flip {
    justify-items: end;
  }

  /* The keystroke drives each beat — pounce is keyboard-first, so the
     shortcut IS the story. One chip per beat, cast over the pane it acts on. */
  .key-cast {
    position: absolute;
    top: 17%;
    z-index: 4;
    padding: 0.5em 0.75em;
    background: color-mix(in srgb, var(--crust) 94%, transparent);
    border: 1px solid var(--surface1);
    border-radius: 9px;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45);
    color: var(--text);
    font-family: var(--mono);
    font-size: 1.1em;
    font-style: normal;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateX(-50%) scale(0.86);
  }

  /* Perch's code-native preview: the cursor is the actor the way keystrokes
     are pounce's — every scene change is a drag it performs. */
  .perch-demo {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at 74% 72%, color-mix(in srgb, var(--green) 14%, transparent), transparent 19%),
      radial-gradient(circle at 77% 70%, transparent 0 12%, color-mix(in srgb, var(--surface2) 48%, transparent) 12.2% 12.5%, transparent 12.7% 19%, color-mix(in srgb, var(--surface2) 33%, transparent) 19.2% 19.5%, transparent 19.7%),
      var(--crust);
    color: var(--text);
    font-family: var(--font);
    font-size: clamp(7px, 1.25cqw, 12px);
    text-align: left;
  }

  .desktop-menu {
    display: flex;
    position: absolute;
    inset: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    height: 5.8%;
    padding: 0 1.6%;
    background: rgba(28, 28, 28, 0.88);
    color: var(--subtext0);
    font-size: 0.76em;
  }

  .desktop-window {
    display: grid;
    position: absolute;
    grid-template-columns: 27% 73%;
    grid-template-rows: 12% 88%;
    overflow: hidden;
    background: color-mix(in srgb, var(--base) 94%, transparent);
    border: 1px solid var(--surface1);
    border-radius: 9px;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.34);
  }

  /* The browser and Finder live in different corners of the desk — real
     desktops aren't one window slot — and swap on the same frame. Both sit
     clear of the shelf's drop zone under the notch. */
  .win-browser {
    top: 20%;
    left: 5%;
    width: 52%;
    height: 56%;
    grid-template-columns: 1fr;
    animation: browser-shows 20s linear infinite;
  }

  .win-finder {
    top: 30%;
    left: 38%;
    width: 55%;
    height: 52%;
    opacity: 0;
    animation: finder-shows 20s linear infinite;
  }

  .url-pill {
    max-width: 60%;
    padding: 0.3em 1.4em;
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 0.9em;
    color: var(--subtext0);
    font-family: var(--mono);
    font-size: 0.72em;
  }

  /* The page under test: the pounce landing, in miniature. */
  .browser-page {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.55em;
    text-align: center;
  }

  .bp-eyebrow {
    margin: 0;
    color: var(--overlay1);
    font-family: var(--mono);
    font-size: 0.62em;
    letter-spacing: 0.06em;
  }

  .bp-title {
    margin: 0;
    font-size: 1.5em;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .bp-title b {
    color: var(--blue);
  }

  .bp-lede {
    width: 46%;
    height: 0.36em;
    background: var(--surface1);
    border-radius: 2px;
  }

  .bp-lede.short {
    width: 30%;
  }

  .bp-cta {
    margin-top: 0.5em;
    padding: 0.45em 1em;
    background: var(--blue);
    border-radius: 7px;
    color: var(--crust);
    font-size: 0.72em;
    font-weight: 650;
    animation: cta-clicked 20s linear infinite;
  }

  /* Finder shows two views in one frame slot: the shots folder it opened
     on, then Applications once its favorite is clicked. The title sits left
     of center — centered it would hide behind the open shelf. */
  .desktop-window header .win-title {
    justify-items: start;
    margin: 0 auto 0 0.8em;
  }

  .ti-shots {
    animation: finder-first-view 20s steps(1, end) infinite;
  }

  .ti-apps {
    opacity: 0;
    animation: finder-second-view 20s steps(1, end) infinite;
  }

  .win-finder .desktop-main {
    grid-area: 2 / 2;
  }

  .main-shots {
    animation:
      finder-first-view 20s steps(1, end) infinite,
      main-a-glows 20s linear infinite;
  }

  .main-apps {
    opacity: 0;
    animation:
      finder-second-view 20s steps(1, end) infinite,
      main-b-glows 20s linear infinite;
  }

  .fav-shots,
  .fav-apps {
    margin: -0.3em -0.5em;
    padding: 0.3em 0.5em;
    border-radius: 5px;
  }

  .fav-shots {
    animation: fav-shots-selected 20s steps(1, end) infinite;
  }

  .fav-apps {
    animation: fav-apps-selected 20s steps(1, end) infinite;
  }

  /* The landed copies — they pop into the view that accepted them. */
  .file-card.card-shot {
    opacity: 0;
    transform: translateY(4px) scale(0.85);
    animation: card-shot-lands 20s ease-out infinite;
  }

  .file-card.card-app {
    opacity: 0;
    transform: translateY(4px) scale(0.85);
    animation: card-app-lands 20s ease-out infinite;
  }

  /* Real app icons, same bitmaps as the pounce rows and the Dock. */
  .app-ico {
    display: block;
    width: 2.4em;
    height: 2.4em;
  }

  .shelf-item .app-ico {
    width: 2.2em;
    height: 2.2em;
  }

  /* A macOS screenshot in miniature: white-bordered, one per app. */
  .shot-mini {
    display: block;
    position: relative;
    overflow: hidden;
    width: 2.6em;
    height: 1.7em;
    border: 1.5px solid var(--text);
    border-radius: 3px;
    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.45);
  }

  .mini-browser {
    background: linear-gradient(var(--surface1) 0 22%, var(--base) 22%);
  }

  .mini-browser::after {
    position: absolute;
    inset: 42% 30%;
    background: var(--blue);
    border-radius: 2px;
    content: '';
    opacity: 0.85;
  }

  /* The capture flash, then the floating thumbnail macOS parks bottom-right. */
  .shutter {
    position: absolute;
    z-index: 7;
    inset: 0;
    background: var(--text);
    opacity: 0;
    pointer-events: none;
    animation: shutter-fires 20s linear infinite;
  }

  .kc-shot {
    top: 16%;
    left: 66%;
    animation: keycast-shots 20s ease-out infinite;
  }

  .thumb {
    position: absolute;
    right: 5.5%;
    bottom: 11%;
    z-index: 4;
    opacity: 0;
  }

  .thumb .shot-mini {
    width: 6.2em;
    height: 4em;
    border-width: 2px;
    border-radius: 5px;
  }

  .thumb-a {
    animation: thumb-parks 20s ease-out infinite;
  }

  /* The desk chrome perch shares the screen with: a Dock with real app
     icons and a Downloads stack that fans the fresh download open. */
  /* The screen div bleeds ~2.4% under the frame's bezel art (pinned
     geometry), so the Dock floats clear of that covered strip. */
  .dock {
    display: flex;
    position: absolute;
    bottom: 9.5%;
    left: 50%;
    z-index: 2;
    align-items: center;
    gap: 0.55em;
    padding: 0.45em 0.65em;
    background: color-mix(in srgb, var(--surface0) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--surface2) 40%, transparent);
    border-radius: 1em;
    transform: translateX(-50%);
  }

  .dock img {
    display: block;
    width: 2.3em;
    height: 2.3em;
  }

  .dock .sep {
    width: 1px;
    height: 2em;
    background: var(--surface2);
  }

  .dock .stack {
    display: grid;
    position: relative;
    width: 2.1em;
    height: 2.1em;
    place-items: center;
    background: color-mix(in srgb, var(--blue) 18%, var(--surface1));
    border-radius: 22%;
    color: var(--blue);
    font-weight: 700;
    animation: stack-bounces 20s ease-out infinite;
  }

  .dl-badge {
    display: grid;
    position: absolute;
    top: -0.45em;
    right: -0.45em;
    width: 1.25em;
    height: 1.25em;
    place-items: center;
    background: var(--blue);
    border-radius: 50%;
    color: var(--crust);
    font-size: 0.66em;
    font-weight: 750;
    opacity: 0;
    transform: scale(0.4);
    animation: badge-pops 20s ease-out infinite;
  }

  .dl-fan {
    display: grid;
    position: absolute;
    bottom: 21%;
    left: 56.5%;
    z-index: 2;
    justify-items: center;
    gap: 0.3em;
    opacity: 0;
    transform: translate(-50%, 8px) scale(0.88);
    transform-origin: bottom;
    animation: fan-opens 20s ease-out infinite;
  }

  .dl-fan img {
    display: block;
    width: 3em;
    height: 3em;
  }

  .dl-fan em {
    padding: 0.2em 0.6em;
    background: color-mix(in srgb, var(--crust) 92%, transparent);
    border: 1px solid var(--surface1);
    border-radius: 1em;
    color: var(--subtext0);
    font-family: var(--mono);
    font-size: 0.68em;
    font-style: normal;
  }

  /* Drag ghosts: the staged copy travelling under the cursor; leaving the
     shelf it wears the copy pledge. */
  .drag-ghost {
    display: block;
    position: absolute;
    z-index: 5;
    opacity: 0;
    transform: rotate(-4deg);
  }

  .drag-ghost .shot-mini {
    width: 3.2em;
    height: 2.1em;
  }

  .drag-ghost .app-ico {
    width: 2.6em;
    height: 2.6em;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.45));
  }

  .g-shot-in {
    animation: ghost-shot-in 20s ease-in-out infinite;
  }

  .g-dl-in {
    animation: ghost-dl-in 20s ease-in-out infinite;
  }

  .g-shot-out {
    animation: ghost-shot-out 20s ease-in-out infinite;
  }

  .g-dl-out {
    animation: ghost-dl-out 20s ease-in-out infinite;
  }

  .desktop-window header {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 5px;
    padding: 0 2.3%;
    background: var(--mantle);
    border-bottom: 1px solid var(--surface0);
  }

  /* Direct children only — the Finder title's stacked <i> flip lives in
     this header too and must not become a 7px traffic light. */
  .desktop-window header > i {
    width: 7px;
    height: 7px;
    background: var(--surface2);
    border-radius: 50%;
  }

  .desktop-window header span {
    margin: auto;
    color: var(--subtext0);
    font-size: 0.78em;
  }

  .desktop-window aside {
    display: flex;
    flex-direction: column;
    gap: 8%;
    padding: 10%;
    background: color-mix(in srgb, var(--mantle) 92%, transparent);
    border-right: 1px solid var(--surface0);
    color: var(--subtext0);
    font-size: 0.8em;
  }

  .desktop-window aside b {
    color: var(--overlay1);
    font-family: var(--mono);
    font-size: 0.8em;
    text-transform: uppercase;
  }

  .desktop-window .desktop-main {
    display: flex;
    align-items: flex-start;
    gap: 8%;
    padding: 10%;
  }

  .file-card,
  .shelf-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    color: var(--subtext0);
    font-size: 0.74em;
  }

  .file-card i,
  .shelf-item i {
    display: block;
    position: relative;
    width: 30px;
    height: 25px;
    border-radius: 3px;
  }

  /* Grows out of the notch, not from under it: the shelf starts at the
     panel's top edge and runs up BEHIND the notch (the frame paints over
     it, z-index 3 over 2), so opening reads as the notch extruding. The
     top padding clears the notch's ~6% bite before the header renders. */
  .perch-shelf {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    width: 34%;
    padding: 7% 1.6% 1.6%;
    background: color-mix(in srgb, var(--mantle) 97%, transparent);
    border: 1px solid var(--surface1);
    border-radius: 0 0 13px 13px;
    box-shadow: 0 17px 40px rgba(0, 0, 0, 0.48);
    transform: translate(-50%, -84%) scaleX(0.35);
    transform-origin: top;
    animation: shelf-opens 20s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .perch-shelf header {
    display: flex;
    justify-content: space-between;
    padding-bottom: 4%;
    color: var(--subtext0);
    font-family: var(--mono);
    font-size: 0.72em;
  }

  .perch-shelf header b {
    color: var(--green);
    font-weight: 500;
  }

  /* The header narrates the shelf's state — four stacked lines snapped on
     the frames things land or leave ("1 thing waiting" plays twice: on the
     way in and again after the first shot files out). */
  .st-one,
  .st-two,
  .st-empty {
    opacity: 0;
  }

  .st-drop {
    animation: state-drop 20s steps(1, end) infinite;
  }

  .st-one {
    animation: state-one 20s steps(1, end) infinite;
  }

  .st-two {
    animation: state-two 20s steps(1, end) infinite;
  }

  .st-empty {
    animation: state-empty 20s steps(1, end) infinite;
  }

  .shelf-items {
    display: flex;
    justify-content: center;
    gap: 13%;
    padding: 6%;
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 8px;
  }

  /* Tiles pop as their ghosts land, dim while being dragged out, and vanish
     the frame the destination accepts them. */
  .shelf-item.sh-a {
    opacity: 0;
    animation: shot-a-waits 20s ease-out infinite;
  }

  .shelf-item.sh-b {
    opacity: 0;
    animation: shot-b-waits 20s ease-out infinite;
  }

  .copy-pill {
    position: absolute;
    right: -0.7em;
    bottom: -1.4em;
    padding: 0.16em 0.55em;
    background: color-mix(in srgb, var(--pink) 18%, var(--crust));
    border: 1px solid color-mix(in srgb, var(--pink) 45%, transparent);
    border-radius: 1em;
    color: var(--pink);
    font-family: var(--mono);
    font-size: 0.68em;
    font-style: normal;
  }

  /* A drawn macOS arrow — the demo's actor. Parked at the base position so
     a reduced-motion or frame-0 render isn't a corner artifact. */
  .cursor {
    position: absolute;
    top: 46%;
    left: 78%;
    z-index: 6;
    width: 1.1em;
    height: 1.55em;
    background: var(--text);
    clip-path: polygon(0 0, 0 78%, 22% 63%, 38% 100%, 54% 92%, 37% 58%, 62% 56%);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.65));
    animation:
      cursor-roams 20s ease-in-out infinite,
      cursor-clicks 20s linear infinite;
  }

  /* The 14s clock, in seconds: summon at 0, recency list up by 0.2. Typing
     starts at 2.2 — s, l, a — and at 2.62 the list snaps to the Slack
     results ON the same frame the recency palette drops (disjoint keyframes,
     no crossfade); c and k land at 2.7 and 2.85. ↵ at 4.3, closed by 4.8.
     Summon 2 at 5.6 types "claude" by 6.6, rows blooming mid-word; ↵ at 8,
     gone by 8.6. Summon 3 at 9.2 types the conversion by 10.7, the answer
     card pops at 10.8; ↵ copies at 12.4, gone by 13. The last second is
     empty desktop so the loop can breathe. */
  @keyframes recency-summons {
    0% {
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.97);
    }
    1.4%, 18.7% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    18.75%, 100% {
      opacity: 0;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @keyframes slack-appears {
    0%, 18.65% {
      opacity: 0;
      transform: translate(-50%, 0) scale(1);
    }
    18.7%, 32.9% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    34.3%, 100% {
      opacity: 0;
      transform: translate(-50%, -4px) scale(0.99);
    }
  }

  @keyframes palette-summons {
    0%, 40% {
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.97);
    }
    41.4%, 60% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    61.4%, 100% {
      opacity: 0;
      transform: translate(-50%, -4px) scale(0.99);
    }
  }

  @keyframes convert-summons {
    0%, 65.7% {
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.97);
    }
    67.1%, 91.4% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
    92.9%, 100% {
      opacity: 0;
      transform: translate(-50%, -4px) scale(0.99);
    }
  }

  @keyframes types-sla {
    0%, 15.7% {
      width: 0;
    }
    16.8% {
      width: 1ch;
    }
    17.9% {
      width: 2ch;
    }
    18.6%, 100% {
      width: 3ch;
    }
  }

  /* Picks up mid-word at the swap: sla → slac → slack. */
  @keyframes types-slack {
    0%, 19.2% {
      width: 3ch;
    }
    19.9% {
      width: 4ch;
    }
    20.7%, 100% {
      width: 5ch;
    }
  }

  @keyframes types-claude {
    0%, 42.1% {
      width: 0;
    }
    42.9% {
      width: 1ch;
    }
    43.6% {
      width: 2ch;
    }
    44.3% {
      width: 3ch;
    }
    45% {
      width: 4ch;
    }
    45.7% {
      width: 5ch;
    }
    46.4%, 100% {
      width: 6ch;
    }
  }

  @keyframes types-convert {
    0%, 68.6% {
      width: 0;
      animation-timing-function: steps(14, end);
    }
    76.4%, 100% {
      width: 14ch;
    }
  }

  @keyframes rows-bloom {
    0%, 0.7% {
      opacity: 0;
      transform: translateY(5px);
    }
    3.6%, 100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* No slide for the slack rows — a live list re-render snaps. */
  @keyframes rows-snap {
    0%, 18.65% {
      opacity: 0;
    }
    18.7%, 100% {
      opacity: 1;
    }
  }

  /* The claude rows land while the word is still being typed — results
     chase the query, they don't wait for it. */
  @keyframes rows-bloom-late {
    0%, 43% {
      opacity: 0;
      transform: translateY(5px);
    }
    46%, 100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes answer-grows {
    0%, 76.4% {
      grid-template-rows: 0fr;
      padding-block: 0;
    }
    78%, 100% {
      grid-template-rows: 1fr;
      padding-block: 0.55em 0.75em;
    }
  }

  @keyframes field-divides {
    0%, 76.9% {
      border-bottom-color: transparent;
    }
    77%, 100% {
      border-bottom-color: var(--surface0);
    }
  }

  @keyframes answer-pops {
    0%, 77.3% {
      opacity: 0;
      transform: translateY(5px);
    }
    78.8%, 100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes actioned-a {
    0%, 30% {
      filter: brightness(1);
    }
    31% {
      filter: brightness(1.45);
    }
    32.1%, 100% {
      filter: brightness(1);
    }
  }

  @keyframes actioned-b {
    0%, 56.4% {
      filter: brightness(1);
    }
    57.5% {
      filter: brightness(1.45);
