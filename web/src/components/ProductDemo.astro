    background:
      radial-gradient(circle at 74% 72%, color-mix(in srgb, var(--green) 14%, transparent), transparent 19%),
      radial-gradient(circle at 77% 70%, transparent 0 12%, color-mix(in srgb, var(--surface2) 48%, transparent) 12.2% 12.5%, transparent 12.7% 19%, color-mix(in srgb, var(--surface2) 33%, transparent) 19.2% 19.5%, transparent 19.7%),
      var(--crust);
    color: var(--text);
