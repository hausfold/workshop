---
interface Props {
  product: 'pounce' | 'trill' | 'perch';
}

const { product } = Astro.props;

const content = {
  pounce: {
    label: '⌘ space to done',
    title: 'Thought to action, before the thought leaves.',
    copy: 'Summon it, type what you mean, and get back to the work. No dashboard. No ceremony.',
  },
  trill: {
    label: 'your inbox at working speed',
    title: 'A conversation, not a control room.',
    copy: 'Triage the thread, find the thing, write the reply. Your messages stay local and close to the keyboard.',
  },
  perch: {
    label: 'the notch earns its keep',
    title: 'A temporary shelf that moves at your speed.',
    copy: 'Flick something up, keep working, then carry it where it belongs. The original never moves.',
  },
}[product];
---

<section class="product-demo" aria-labelledby={`${product}-demo-title`} data-product-demo={product}>
  <div class="demo-heading">
    <div>
      <p class="demo-label">{content.label}</p>
      <h2 id={`${product}-demo-title`}>{content.title}</h2>
    </div>
    <p>{content.copy}</p>
  </div>

  <div class="demo-viewport">
    <div class="demo-stage">
      <figure class="macbook">
        <div class="macbook-render">
          <div class="macbook-screen">
            {
              product === 'pounce' ? (
                <div
                  class="pounce-demo"
                  role="img"
                  aria-label="Pounce summoned over a desktop three times — launching an app, filtering to Slack, and running a Wi-Fi command next to its System Settings deep link"
                >
                  <div class="desktop-bar" aria-hidden="true">
                    <span class="bar-group">
                      <i class="pill accent">1</i>
                      <i class="pill">pounce</i>
                    </span>
                    <span class="bar-group">
                      <i class="pill">15%</i>
                      <i class="pill">25°</i>
                      <i class="pill">Wed Jul 29&nbsp;&nbsp;9:41</i>
                    </span>
                  </div>
                  <div class="pounce-palette scene-obs" aria-hidden="true">
                    <div class="palette-field">
                      <i class="glass" />
                      <b>obs</b>
                      <i class="caret" />
                    </div>
                    <div class="palette-rows">
                      <div class="palette-row selected">
                        <span class="row-icon app-a" />
                        <b>Obsidian</b>
                        <em>Application</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon app-b" />
                        <b>OrbStack</b>
                        <em>Application</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-star" />
                        <b>Nix Config</b>
                        <em>Open in editor</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-ring" />
                        <b>Emoji</b>
                        <em>Search &amp; paste emoji</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-frame" />
                        <b>Screenshots</b>
                        <em>Browse recent captures</em>
                      </div>
                    </div>
                    <footer>
                      <span>Open<kbd>↵</kbd></span>
                      <span>Reveal in Finder<kbd>⌘↵</kbd></span>
                    </footer>
                  </div>
                  <div class="pounce-palette scene-slack" aria-hidden="true">
                    <div class="palette-field">
                      <i class="glass" />
                      <b>slack</b>
                      <i class="caret" />
                    </div>
                    <div class="palette-rows">
                      <div class="palette-row selected">
                        <span class="row-icon app-c" />
                        <b>Slack</b>
                        <em>Application</em>
                      </div>
                    </div>
                    <footer>
                      <span>Open<kbd>↵</kbd></span>
                      <span>Reveal in Finder<kbd>⌘↵</kbd></span>
                    </footer>
                  </div>
                  <div class="pounce-palette scene-wifi" aria-hidden="true">
                    <div class="palette-field">
                      <i class="glass" />
                      <b>wifi</b>
                      <i class="caret" />
                    </div>
                    <div class="palette-rows">
                      <div class="palette-row selected">
                        <span class="row-icon mark-wave" />
                        <b>Wi-Fi</b>
                        <em>Turn Wi-Fi off</em>
                      </div>
                      <div class="palette-row">
                        <span class="row-icon mark-slider" />
                        <b>Wi-Fi</b>
                        <em>System Settings</em>
                      </div>
                    </div>
                    <footer>
                      <span>Run<kbd>↵</kbd></span>
                      <span>Open Settings<kbd>⌘↵</kbd></span>
                    </footer>
                  </div>
                </div>
              ) : product === 'trill' ? (
                <div class="trill-demo" role="img" aria-label="Trill showing a fast, local Messages inbox">
                  <div class="trill-sidebar" aria-hidden="true">
                    <div class="window-tools"><i /><i /><i /></div>
                    <div class="trill-search">⌕&nbsp;&nbsp;Search everything</div>
                    <div class="inbox-label"><span>inbox</span><b>12</b></div>
                    <div class="chat-row">
                      <span class="avatar mauve">JM</span>
                      <span><b>Jo</b><small>landing demo is looking sharp</small></span>
                      <time>now</time>
                    </div>
                    <div class="chat-row selected">
                      <span class="avatar blue">AK</span>
                      <span><b>Alex</b><small>Can you send the build?</small></span>
                      <time>9:41</time>
                    </div>
                    <div class="chat-row">
                      <span class="avatar green">ops</span>
                      <span><b>Backend</b><small>deploy finished cleanly</small></span>
                      <time>9:32</time>
                    </div>
                    <div class="chat-row dim">
                      <span class="avatar peach">M</span>
                      <span><b>Mom</b><small>Photo</small></span>
                      <time>Tue</time>
                    </div>
                  </div>
                  <div class="trill-thread" aria-hidden="true">
                    <header>
                      <span class="avatar blue">AK</span>
                      <span><b>Alex</b><small>iMessage · local</small></span>
                      <em>⌘ K</em>
                    </header>
                    <div class="message-space">
                      <div class="day">today 9:41</div>
                      <p class="bubble received">Can you send the build?</p>
                      <p class="bubble sent">Already there — check Releases.</p>
                      <p class="bubble received incoming">Perfect. That was fast.</p>
                    </div>
                    <footer><span>Message Alex…</span><b>↑</b></footer>
                  </div>
                  <aside class="trill-detail" aria-hidden="true">
                    <span class="avatar blue">AK</span>
                    <h3>Alex Kim</h3>
                    <p>needs reply · 2 links · 4 files</p>
                    <div><b>local notes</b><span>release follow-up</span></div>
                    <div><b>shared today</b><span>v2026.07.29</span></div>
                  </aside>
                </div>
              ) : (
                <div class="perch-demo" role="img" aria-label="Perch opening a temporary file shelf from the MacBook notch">
                  <div class="desktop-menu" aria-hidden="true">
                    <span>⌁ &nbsp; Finder &nbsp; File &nbsp; Edit &nbsp; View</span>
                    <span>◔ &nbsp; 100% &nbsp; Wed Jul 29 &nbsp; 9:41</span>
                  </div>
                  <div class="desktop-window" aria-hidden="true">
                    <header><i /><i /><i /><span>release</span></header>
                    <aside>
                      <b>Favorites</b>
                      <span>⌂ &nbsp; AirDrop</span>
                      <span>▣ &nbsp; Applications</span>
                      <span>⌁ &nbsp; Downloads</span>
                    </aside>
                    <div class="desktop-main">
                      <div class="file-card"><i class="folder" /><span>build</span></div>
                      <div class="file-card"><i class="document" /><span>notes.md</span></div>
                      <div class="file-card"><i class="image" /><span>hero.png</span></div>
                    </div>
                  </div>
                  <div class="perch-shelf" aria-hidden="true">
                    <header><span>3 things waiting</span><b>copy-only</b></header>
                    <div class="shelf-items">
                      <div class="shelf-item"><i class="folder" /><span>build</span></div>
                      <div class="shelf-item"><i class="document" /><span>notes.md</span></div>
                      <div class="shelf-item lifted"><i class="image" /><span>hero.png</span></div>
                    </div>
                  </div>
                </div>
              )
            }
          </div>
          <img
            class="macbook-frame"
            src="/media/macbook-pro-orthographic.svg"
            alt=""
            width="1648"
            height="1158"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .product-demo {
    margin: 0 0 6.5rem;
  }

  .demo-heading {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: end;
    gap: 3rem;
    margin: 0 0 1.8rem;
  }

  .demo-label {
    margin: 0 0 0.7rem;
    color: var(--product-accent);
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.055em;
    text-transform: lowercase;
  }

  .demo-heading h2 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .demo-heading > p {
    max-width: 470px;
    margin: 0 0 0.25rem;
    color: var(--subtext0);
    font-size: 0.94rem;
  }

  .demo-viewport {
    padding: 0.5rem 0 0.9rem;
    overflow: clip;
  }

  .demo-stage {
    display: grid;
    width: 100%;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
  }

  .macbook {
    position: relative;
    width: min(960px, calc(100% - 1rem));
    margin: 0;
  }

  /* Grounding on a near-black page: a shadow would vanish, so the laptop
     sits in a faint pool of its own accent light instead. */
  .macbook::after {
    position: absolute;
    right: 7%;
    bottom: -2.6%;
    left: 7%;
    height: 5%;
    background: radial-gradient(50% 100% at 50% 0, color-mix(in srgb, var(--product-accent, var(--mauve)) 17%, transparent), transparent 74%);
    content: '';
  }

  /* Geometry mirrors macbook-pro-orthographic.svg's 1648 × 1158 viewBox:
     the panel cutout is x 58–1590, y 34–1029. */
  .macbook-render {
    position: relative;
    aspect-ratio: 1648 / 1128;
    container-type: inline-size;
  }

  .macbook-screen {
    position: absolute;
    top: 3.014%;
    left: 3.519%;
    z-index: 1;
    width: 92.961%;
    height: 88.209%;
    overflow: hidden;
    background: var(--crust);
    border-radius: 1.96% 1.96% 0.52% 0.52%;
    isolation: isolate;
  }

  .macbook-frame {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Pounce's code-native preview: the real palette chrome, synthetic results. */
  .pounce-demo {
    display: grid;
    position: relative;
    width: 100%;
    height: 100%;
    align-content: start;
    overflow: hidden;
    background:
      radial-gradient(95% 72% at 50% 6%, color-mix(in srgb, var(--mauve) 9%, transparent), transparent 62%),
      radial-gradient(circle at 68% 78%, transparent 0 16%, color-mix(in srgb, var(--mauve) 26%, transparent) 16.1% 16.4%, transparent 16.5% 27%, color-mix(in srgb, var(--sapphire) 22%, transparent) 27.1% 27.4%, transparent 27.5% 39%, color-mix(in srgb, var(--surface2) 40%, transparent) 39.1% 39.4%, transparent 39.5%),
      var(--crust);
    color: var(--text);
    font-family: var(--font);
    font-size: clamp(7px, 1.25cqw, 12px);
    text-align: left;
  }

  /* Sill, roughly: pills either side, not a macOS menu bar. */
  .desktop-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 6.6%;
    padding: 0.7% 2.2% 0;
  }

  .bar-group {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .pill {
    padding: 0.32em 0.62em;
    background: color-mix(in srgb, var(--surface0) 62%, transparent);
    border-radius: 0.8em;
    color: var(--overlay1);
    font-family: var(--mono);
    font-size: 0.72em;
    font-style: normal;
    white-space: nowrap;
  }

  .pill.accent {
    background: color-mix(in srgb, var(--mauve) 24%, transparent);
    color: var(--mauve);
  }

  /* Three beats on one 13.2s clock: launch an app, filter down to one hit,
     then a built-in command beside its System Settings deep link. Every scene
     is a whole palette, phase-shifted with --d — real pounce closes on ↵, so
     each beat gets a fresh summon and the height change between beats is free. */
  .pounce-palette {
    position: absolute;
    top: 19%;
    left: 50%;
    width: 62%;
    overflow: hidden;
    background: color-mix(in srgb, var(--crust) 96%, transparent);
    border: 1px solid var(--surface0);
    border-radius: 13px;
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translate(-50%, -8px) scale(0.97);
    animation: palette-summons 13.2s ease-out var(--d, 0s) infinite;
  }

  .scene-slack {
    --d: 4.4s;
  }

  .scene-wifi {
    --d: 8.8s;
  }

  .palette-field {
    display: flex;
    align-items: center;
    gap: 0.85em;
    padding: 1.5em 1.7em;
    border-bottom: 1px solid var(--surface0);
    font-family: var(--mono);
    font-size: 1.2em;
  }

  .palette-field .glass {
    position: relative;
    width: 0.92em;
    height: 0.92em;
    flex: 0 0 auto;
    border: 1.5px solid var(--overlay0);
    border-radius: 50%;
  }

  .palette-field .glass::after {
    position: absolute;
    right: -0.3em;
    bottom: -0.14em;
    width: 0.44em;
    height: 1.5px;
    background: var(--overlay0);
    border-radius: 1px;
    content: '';
    transform: rotate(45deg);
  }

  .palette-field b {
    display: inline-block;
    width: 0;
    overflow: hidden;
    font-weight: 400;
    white-space: nowrap;
    animation: types-3 13.2s steps(1, end) var(--d, 0s) infinite;
  }

  .scene-slack .palette-field b {
    animation-name: types-5;
  }

  .scene-wifi .palette-field b {
    animation-name: types-4;
  }

  .palette-field .caret {
    width: 2px;
    height: 1.25em;
    margin-left: -0.5em;
    background: var(--product-accent, var(--mauve));
    animation: caret-blinks 1.06s steps(2, jump-none) infinite;
  }

  .palette-rows {
    padding: 0.55em;
  }

  .palette-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9em;
    padding: 0.62em 1.1em;
    border-radius: 8px;
    opacity: 0;
    animation: palette-result 13.2s ease-out var(--d, 0s) infinite;
  }

  .palette-row:nth-child(2) {
    animation-delay: calc(var(--d, 0s) + 0.05s);
  }

  .palette-row:nth-child(3) {
    animation-delay: calc(var(--d, 0s) + 0.1s);
  }

  .palette-row:nth-child(4) {
    animation-delay: calc(var(--d, 0s) + 0.15s);
  }

  .palette-row:nth-child(5) {
    animation-delay: calc(var(--d, 0s) + 0.2s);
  }

  .palette-row.selected {
    background: color-mix(in srgb, var(--mauve) 26%, transparent);
    animation:
      palette-result 13.2s ease-out var(--d, 0s) infinite,
      row-actioned 13.2s linear var(--d, 0s) infinite;
  }

  .palette-row b,
  .palette-row em {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-row b {
    font-size: 1.06em;
    font-weight: 600;
  }

  .palette-row em {
    color: var(--overlay1);
    font-size: 0.88em;
    font-style: normal;
  }

  .palette-row.selected em {
    color: var(--subtext0);
  }

  /* Icons are shapes, not logos — at this size a tinted rounded square reads
     as an app and borrows nobody's mark. */
  .row-icon {
    position: relative;
    width: 2em;
    height: 2em;
    background: var(--surface1);
    border-radius: 27%;
  }

  .row-icon.app-a {
    background: linear-gradient(155deg, var(--mauve), color-mix(in srgb, var(--mauve) 45%, var(--crust)));
  }

  .row-icon.app-b {
    background: linear-gradient(155deg, var(--sapphire), color-mix(in srgb, var(--sapphire) 45%, var(--crust)));
  }

  .row-icon.app-c {
    background: linear-gradient(155deg, var(--peach), color-mix(in srgb, var(--peach) 45%, var(--crust)));
  }

  /* Two top-arcs and a dot: a Wi-Fi fan without any glyph. */
  .row-icon.mark-wave {
    background:
      radial-gradient(circle 1.5px at 50% 66%, var(--overlay1) 97%, transparent),
      var(--surface1);
  }

  .row-icon.mark-wave::before,
  .row-icon.mark-wave::after {
    position: absolute;
    border: 1.5px solid transparent;
    border-top-color: var(--overlay1);
    border-radius: 50%;
    content: '';
  }

  .row-icon.mark-wave::before {
    inset: 22% 22% 12%;
  }

  .row-icon.mark-wave::after {
    inset: 38% 36% 24%;
  }

  /* System Settings as sliders: two rails, two knobs. */
  .row-icon.mark-slider {
    background:
      radial-gradient(circle 1.7px at 38% 38%, var(--overlay1) 97%, transparent),
      radial-gradient(circle 1.7px at 64% 62%, var(--overlay1) 97%, transparent),
      linear-gradient(var(--overlay1) 0 100%) 50% 38% / 44% 1.5px no-repeat,
      linear-gradient(var(--overlay1) 0 100%) 50% 62% / 44% 1.5px no-repeat,
      var(--surface1);
  }

  .row-icon.mark-ring::after,
  .row-icon.mark-frame::after {
    position: absolute;
    inset: 30%;
    content: '';
  }

  /* Three bars at 60° apart — a snowflake for the Nix row, without a glyph
     that might resolve to an emoji on someone else's machine. */
  .row-icon.mark-star {
    background:
      linear-gradient(var(--overlay1) 0 100%) center / 1.5px 42% no-repeat,
      var(--surface1);
  }

  .row-icon.mark-star::before,
  .row-icon.mark-star::after {
    position: absolute;
    inset: 29% calc(50% - 0.75px);
    background: var(--overlay1);
    content: '';
  }

  .row-icon.mark-star::before {
    transform: rotate(60deg);
  }

  .row-icon.mark-star::after {
    transform: rotate(-60deg);
  }

  .row-icon.mark-ring::after {
    border: 1.5px solid var(--overlay1);
    border-radius: 50%;
  }

  .row-icon.mark-frame::after {
    border: 1.5px solid var(--overlay1);
    border-radius: 2px;
  }

  .pounce-palette footer {
    display: flex;
    justify-content: flex-end;
    gap: 1.6em;
    padding: 0.95em 1.65em;
    border-top: 1px solid var(--surface0);
    color: var(--overlay1);
    font-size: 0.84em;
  }

  .pounce-palette footer kbd {
    display: inline-grid;
    min-width: 1.9em;
    height: 1.55em;
    margin-left: 0.6em;
    place-items: center;
    background: var(--surface0);
    border-radius: 5px;
    color: var(--subtext0);
    font-family: var(--mono);
    font-size: 0.9em;
    vertical-align: middle;
  }

  /* Trill's code-native preview: real layout language, synthetic data. */
  /* Trill runs full-screen, so it starts below the notch the way macOS puts a
     full-screen app below it — otherwise the notch bites the thread header. */
  .trill-demo {
    display: grid;
    position: absolute;
    grid-template-columns: 29% 48% 23%;
    inset: 7% 0 0;
    overflow: hidden;
    background: var(--base);
    color: var(--text);
    font-family: var(--font);
    font-size: clamp(7px, 1.25cqw, 12px);
    text-align: left;
  }

  .trill-sidebar {
    padding: 3.7% 3.6% 2%;
    background: var(--mantle);
    border-right: 1px solid var(--surface0);
  }

  .window-tools {
    display: flex;
    gap: 4px;
    margin-bottom: 9%;
  }

  .window-tools i {
    width: 7px;
    height: 7px;
    background: var(--surface2);
    border-radius: 50%;
  }

  .trill-search {
    padding: 5% 6%;
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 7px;
    color: var(--overlay1);
    font-family: var(--mono);
  }

  .inbox-label {
    display: flex;
    justify-content: space-between;
    padding: 9% 3% 3%;
    color: var(--overlay1);
    font-family: var(--mono);
    font-size: 0.86em;
  }

  .inbox-label b {
    color: var(--blue);
    font-weight: 500;
  }

  .chat-row {
    display: grid;
    grid-template-columns: 27px 1fr auto;
    align-items: center;
    gap: 8px;
    margin: 2px 0;
    padding: 5% 4%;
    border-radius: 7px;
  }

  .chat-row.selected {
    background: var(--surface0);
  }

  .chat-row.dim {
    opacity: 0.62;
  }

  .chat-row > span:nth-child(2),
  .trill-thread header > span:nth-child(2) {
    min-width: 0;
  }

  .chat-row b,
  .chat-row small,
  .trill-thread header b,
  .trill-thread header small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat-row small,
  .chat-row time,
  .trill-thread header small {
    color: var(--overlay1);
    font-size: 0.8em;
  }

  .avatar {
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    border-radius: 50%;
    color: var(--crust);
    font-size: 0.66em;
    font-weight: 750;
  }

  .avatar.blue {
    background: var(--blue);
  }

  .avatar.mauve {
    background: var(--mauve);
  }

  .avatar.green {
    background: var(--green);
  }

  .avatar.peach {
    background: var(--peach);
  }

  .trill-thread {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-width: 0;
    background: var(--base);
  }

  .trill-thread header {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 12%;
    padding: 2% 4%;
    background: color-mix(in srgb, var(--mantle) 72%, transparent);
    border-bottom: 1px solid var(--surface0);
  }

  .trill-thread header em {
    margin-left: auto;
