#!/usr/bin/env bash
# factory-tier — is this PR tier 1, i.e. mergeable by the night shift alone?
#
#   ./script/factory-tier <repo> <number>              # exit 0 yes · 3 no
#   ./script/factory-tier --paths-only <repo> <number> # just the file filter
#
# Tier 1 is decided by CODE, not by an agent's judgement, and it is
# deliberately narrow: a docs-only PR — every changed file is *.md, or under
# docs/ or content/ — opened by the org owner from a worktree-* branch onto
# main, green and conflict-free. Files that LOOK like docs but steer agents
# or CI (AGENTS.md, CLAUDE.md, any SKILL.md, anything under .github/,
# .claude/ or .agents/) are excluded: a policy change is never tier 1
# however it is spelled. Widening this filter is editing docs/factory.md
# plus this file, in one PR, reviewed by a person.
#
# Prints one verdict line; every refusal names its reason so the shift log
# reads as an audit trail.
set -euo pipefail

paths_only=0
if [ "${1:-}" = "--paths-only" ]; then paths_only=1; shift; fi
repo="${1:-}"; num="${2:-}"
[ -n "$repo" ] && [ -n "$num" ] || { echo "usage: factory-tier [--paths-only] <repo> <number>" >&2; exit 2; }
case "$repo" in */*) ;; *) repo="hausfold/$repo" ;; esac

no() { echo "tier: not-1 — $1  ($repo#$num)"; exit 3; }

json=$(gh pr view "$num" -R "$repo" --json state,isDraft,author,baseRefName,headRefName,mergeable,statusCheckRollup,files,additions,deletions)

# The file filter first: it is the half --paths-only exercises, and the half
# that defines the tier.
bad_path=$(jq -r '
  [.files[].path
   | select(
       (test("^(docs|content)/") or test("\\.md$")) and
       (test("(^|/)(AGENTS|CLAUDE|SKILL)\\.md$") | not) and
       (test("^\\.(github|claude|agents)/") | not)
     | not)
  ] | first // empty' <<<"$json")
[ -z "$bad_path" ] || no "touches $bad_path"
[ "$(jq '.files | length' <<<"$json")" -gt 0 ] || no "no files"

churn=$(jq '.additions + .deletions' <<<"$json")
[ "$churn" -le "${FACTORY_TIER_MAX_LINES:-2000}" ] || no "$churn changed lines (cap ${FACTORY_TIER_MAX_LINES:-2000})"

if [ "$paths_only" = 1 ]; then echo "tier: paths ok ($repo#$num)"; exit 0; fi

[ "$(jq -r .state <<<"$json")" = OPEN ] || no "not open"
[ "$(jq -r .isDraft <<<"$json")" = false ] || no "draft"
[ "$(jq -r .baseRefName <<<"$json")" = main ] || no "base is not main"
jq -e '.headRefName | test("^worktree-")' <<<"$json" >/dev/null || no "head is not a worktree-* branch"
[ "$(jq -r .author.login <<<"$json")" = "$(gh api user -q .login)" ] || no "author is not you"
[ "$(jq -r .mergeable <<<"$json")" = MERGEABLE ] || no "mergeable=$(jq -r .mergeable <<<"$json")"

# Checks: empty rollup is fine (most docs repos run no CI on PRs); anything
# unfinished means "not yet", anything red means no.
pending=$(jq -r '[.statusCheckRollup[]? | select((.status? // "COMPLETED") != "COMPLETED")] | length' <<<"$json")
[ "$pending" = 0 ] || no "checks still running"
red=$(jq -r '[.statusCheckRollup[]?
  | (.conclusion? // .state? // "SUCCESS")
  | select(. != "SUCCESS" and . != "NEUTRAL" and . != "SKIPPED")] | first // empty' <<<"$json")
[ -z "$red" ] || no "check concluded $red"

echo "tier: 1 ($repo#$num · $(jq '.files|length' <<<"$json") files, $churn lines)"
