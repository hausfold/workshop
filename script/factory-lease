#!/usr/bin/env bash
# factory-lease — the standing merge grant the night shift runs under.
#
#   ./script/factory-lease grant 12h     # tier-1 authority for 12 hours
#   ./script/factory-lease status        # exit 0 live · 1 none/expired
#   ./script/factory-lease revoke
#
# A lease is (tier ceiling, expiry). While one is live, factory-shift may
# MERGE tier-1 PRs (docs-only, per factory-tier) on its own; expired or
# revoked, everything queues at "PR open" — i.e. the failure mode of the
# whole factory is the ordinary human-in-the-loop workflow. Only tier 1
# exists today; the column is there so a wider grant is a new value, not a
# new file format.
#
# State is one TSV line — <expires epoch>\t<tier>\t<granted epoch> — in
# ~/.cache/hausfold-factory/, machine-local on purpose: authority to merge
# unattended belongs to this Mac's owner having typed `grant`, never to a
# file a PR could edit.
set -euo pipefail

STATE_DIR="${FACTORY_STATE_DIR:-$HOME/.cache/hausfold-factory}"
LEASE="$STATE_DIR/lease"

usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

parse_duration() { # 30m / 12h / 2d → seconds
  case "$1" in
  *[!0-9smhd]*) echo "factory-lease: bad duration '$1' (use 30m, 12h, 2d)" >&2; exit 2 ;;
  *m) echo $((${1%m} * 60)) ;;
  *h) echo $((${1%h} * 3600)) ;;
  *d) echo $((${1%d} * 86400)) ;;
  *s) echo "${1%s}" ;;
  *)  echo "factory-lease: bad duration '$1' (use 30m, 12h, 2d)" >&2; exit 2 ;;
  esac
}

now=$(date +%s)
case "${1:-}" in
grant)
  [ -n "${2:-}" ] || usage
  secs=$(parse_duration "$2")
  tier="${3:-1}"
  [ "$tier" = 1 ] || { echo "factory-lease: only tier 1 exists (docs/factory.md)" >&2; exit 2; }
  mkdir -p "$STATE_DIR"
  printf '%s\t%s\t%s\n' "$((now + secs))" "$tier" "$now" >"$LEASE"
  echo "lease: tier $tier until $(date -r $((now + secs)) '+%a %H:%M')"
  ;;
status)
  if [ ! -s "$LEASE" ]; then echo "lease: none"; exit 1; fi
  IFS=$'\t' read -r expires tier granted <"$LEASE"
  case "$expires" in '' | *[!0-9]*) echo "lease: unreadable"; exit 1 ;; esac
  if [ "$now" -ge "$expires" ]; then
    echo "lease: expired $(date -r "$expires" '+%a %H:%M')"; exit 1
  fi
  left=$(((expires - now) / 60))
  echo "lease: tier $tier · $((left / 60))h $((left % 60))m left · until $(date -r "$expires" '+%a %H:%M')"
  ;;
revoke)
  rm -f "$LEASE"
  echo "lease: revoked"
  ;;
*) usage ;;
esac
