#!/usr/bin/env bash
# factory-shift — one pass of the night shift: sense, merge what code alone
# can vouch for, report the rest.
#
#   ./script/factory-shift            # act (merges need a live factory-lease)
#   ./script/factory-shift --dry-run  # sense + report only, merge nothing
#
# One pass does four things, in order:
#   budget   read the aiusage pill's own feed (~/.cache/claude-statusline/
#            usage-claude.tsv) and answer the one question the foreman asks
#            of it: can the account afford a fixer lane right now? The line
#            ends `fixer: yes` or `fixer: no (<why>)`, and the foreman
#            spawns on nothing else.
#   merge    every open PR in the org through factory-tier; tier 1 + live
#            lease → `gh pr merge --squash`. Anything else is printed with
#            its reason and left for the morning.
#   ripple   if anything merged: `bench pull` then `bench ship`, so the lock
#            edges never sit stale overnight.
#   ci       the latest completed run on each repo's main; red → a CI-RED
#            line (the foreman's cue to spawn a capped fixer lane) and a
#            trill fault card.
#
# Four lines say the pass could not SEE, and none of them means "nothing to
# report": `prs-unknown` (a repo's open PRs unlistable), `tier-unknown` (one
# PR unjudgeable — distinct from `queued`, which is a judged refusal),
# `ci-unknown` (a main whose latest run is unreadable), and a non-zero
# `pass ABORTED` (no repo list, so nothing was sensed at all). Silence is a
# claim, and here it is only ever the claim that something was looked at.
#
# Every line is appended to $STATE_DIR/shift-YYYYMMDD.log — the morning
# report is that file, not a memory of it. Deterministic on purpose: no
# judgement lives here, so what happened while you slept is exactly what
# this file says happens.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="${FACTORY_STATE_DIR:-$HOME/.cache/hausfold-factory}"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/shift-$(date +%Y%m%d).log"
dry=0; [ "${1:-}" = "--dry-run" ] && dry=1

say() { echo "$*"; printf '%s %s\n' "$(date '+%H:%M')" "$*" >>"$LOG"; }
notify() { # notify <kind> <title> [url]
  command -v trill >/dev/null 2>&1 || return 0
  trill send --source factory --kind "$1" --title "$2" ${3:+--url "$3"} >/dev/null 2>&1 || true
}
# One event is one line in the log, so anything quoted into one has to become
# one: a `gh` error is often several, and a wrapped line stops `grep`ing as an
# event. Truncated because the discriminating part of these messages is at the
# front (`connection reset by peer`, `HTTP 403`, `Bad credentials`).
oneline() { printf '%s' "$*" | tr '\n\t' '  ' | tr -s ' ' | cut -c1-160; }
# Where a failed command's stderr is parked long enough to be quoted into its
# own log line. Under $STATE_DIR rather than mktemp so a killed pass leaves it
# beside the log it belongs to instead of in the system temp dir.
ERRF="$STATE_DIR/.stderr.$$"
trap 'rm -f "$ERRF"' EXIT

# ── budget ────────────────────────────────────────────────────────────────────
# Written by haus's modules/ai/statusline-refresh.sh (the aiusage pill's
# feed) — a two-repo artifact with nothing checking agreement, so the
# percentages are sanity-checked before anything trusts them: a column
# reorder over there must degrade this line to "unreadable", never
# mis-throttle the foreman with a number that still happens to parse.
#
# The line ends in a VERDICT, `fixer: yes` or `fixer: no (<why>)`, and that
# is the whole throttle. It is decided here rather than left to the skill's
# prose because a threshold written out in English, in another file, over
# numbers only this one can see, is a threshold no test can reach — and its
# refusal is the same word as a correct refusal, so a gate stuck shut looks
# exactly like a gate doing its job. What stays the foreman's is whether a red
# main is WORTH a lane; whether the account can afford one is answered here,
# once, and logged where the morning reads it.
#
# The question is forward-looking on purpose. "Is the week spent no faster
# than the clock so far" is a question nobody has, and it cannot be answered
# yes by anything but an idle week: spend is monotonic and the clock is not
# rewindable, so one honest burst on Monday reads over-budget until the reset
# however much is left. The question worth asking is whether spending a lane
# NOW still leaves the human enough to finish the week — so RESERVE points of
# the weekly window are held for them and drain with the clock, and the
# factory may spend what is left below the ceiling.
CEILING=95 # of the weekly window; the top 5 points are nobody's
RESERVE=70 # points held for the human, drained evenly across the week
FIXER=5    # headroom one fixer lane must find, in points of the weekly window
# FIXER is an allowance, not a measurement — nothing meters a lane. It does
# not need to be exact: headroom is re-read from actual spend every pass, so
# a lane that costs more than its allowance shows up as less headroom for the
# next one. Widening any of the three is a reviewed edit here and in
# docs/factory.md, the same way factory-tier's filter is.
USAGE_TSV="${FACTORY_USAGE_TSV:-$HOME/.cache/claude-statusline/usage-claude.tsv}"
if [ -s "$USAGE_TSV" ]; then
  IFS=$'\t' read -r p5 pw _r5 rw _rest <"$USAGE_TSV"
  now=$(date +%s)
  # Every arm ends in a verdict, and every arm that could not do the
  # arithmetic ends in `no`: an unknown budget is not permission, it is the
  # same named unknown the rest of this script degrades to.
  if ! [ "${p5:-x}" -le 100 ] 2>/dev/null || ! [ "${pw:-x}" -le 100 ] 2>/dev/null; then
    say "budget: unreadable feed at $USAGE_TSV (columns moved?) · fixer: no (budget unknown)"
  elif [ "${rw:-0}" -gt "$now" ] 2>/dev/null; then
    reserve=$((RESERVE * (rw - now) / 604800))
    headroom=$((CEILING - pw - reserve))
    # 5h first, and it is not about the week at all: a factory that saturates
    # the rolling window at 4 a.m. rate-limits the person who sits down at 9.
    if [ "$p5" -ge 80 ]; then
      verdict="no (5h window at ${p5}%)"
    elif [ "$headroom" -lt "$FIXER" ]; then
      verdict="no (headroom ${headroom} pts, one fixer needs ${FIXER})"
    else
      verdict=yes
    fi
    say "budget: 5h ${p5}% · week ${pw}% · reserve ${reserve} pts · headroom ${headroom} pts · fixer: $verdict"
  else
    say "budget: 5h ${p5}% · week ${pw}% (no weekly reset stamp — headroom unknown) · fixer: no (budget unknown)"
  fi
else
  say "budget: unknown — no usage feed at $USAGE_TSV · fixer: no (budget unknown)"
fi

# ── lease ─────────────────────────────────────────────────────────────────────
lease_live=0
if lease_line=$("$ROOT/script/factory-lease" status); then lease_live=1; fi
say "$lease_line"
[ "$dry" = 1 ] && say "dry-run: sensing only, merging nothing"

# ── merge + ci, per repo ──────────────────────────────────────────────────────
merged=0
# The org listing is the subject of everything below it. When it fails, the
# loop runs zero times and the pass still ends on "pass done: 0 merged" —
# which is character-for-character what a genuinely quiet night prints. Same
# rule the budget block above already states about itself: degrade to a
# stated unknown, never to an answer that happens to parse. A pass that
# sensed nothing exits non-zero so the foreman cannot read it as a clean one.
if ! repos=$(gh repo list hausfold --no-archived --limit 50 --json name -q '.[].name' 2>"$ERRF"); then
  say "pass ABORTED: hausfold's repos could not be listed: $(oneline "$(cat "$ERRF")")"
  # This one DOES card, where ci-unknown does not, and the asymmetry is the
  # blast radius rather than the cause: ci-unknown is one repo unseen in a
  # pass that otherwise ran, and this is the whole pass dead. The title says
  # what happened, not why — a rate limit, an expired token and a dropped
  # connection all arrive here and only the log line tells them apart.
  notify fault "factory: pass aborted, no repos listed"
  exit 1
fi
if [ -z "$repos" ]; then
  say "pass ABORTED: hausfold listed zero repos — refusing to call that a quiet night"
  notify fault "factory: pass aborted, repo list came back empty"
  exit 1
fi
for repo in $repos; do
  # Listed into a variable rather than iterated through `< <(gh pr list …)`,
  # because a process substitution's exit status is unreachable: a failed
  # listing yields zero iterations, and a repo whose PRs were never read is
  # then indistinguishable from a repo with none open. An empty list is a
  # fact; an unreadable one is a gap in the pass.
  if pr_rows=$(gh pr list -R "hausfold/$repo" -L 100 --json number,title \
    -q '.[] | [.number, .title] | @tsv' 2>/dev/null); then
    while IFS=$'\t' read -r num title; do
      [ -n "$num" ] || continue
      # factory-tier's contract is 0 tier-1 · 3 refused-with-a-reason · 2
      # usage, and anything else is `set -e` aborting inside it — most often
      # on a `gh` call. Those are three answers, not two. "Refused" and
      # "could not be judged" collapsing into one `queued:` line is the
      # expensive one: the nightshift skill tells the foreman that queued
      # rows need nothing because they are the morning's by design, so a PR
      # nobody managed to sense gets filed as one nobody needs to look at.
      verdict=$("$ROOT/script/factory-tier" "$repo" "$num" 2>&1); tier_rc=$?
      case "$tier_rc" in
      0)
        if [ "$dry" = 1 ] || [ "$lease_live" = 0 ]; then
          tag=""; [ "$lease_live" = 0 ] && tag=" (no lease)"
          say "would-merge: $repo#$num $title$tag"
        # Pinned to the head SHA the verdict was computed on: a push landing
        # in the gap makes the merge fail closed to merge-failed, not ride in.
        elif gh pr merge "$num" -R "hausfold/$repo" --squash \
          --match-head-commit "${verdict##*head=}" >/dev/null 2>&1; then
          say "merged: $repo#$num $title"
          merged=$((merged + 1))
        else
          say "merge-failed: $repo#$num — left open"
        fi
        ;;
      3) say "queued: $repo#$num $title — ${verdict#tier: not-1 — }" ;;
      *) say "tier-unknown: $repo#$num $title — not judged: $(oneline "$verdict")" ;;
      esac
    done <<<"$pr_rows"
  else
    say "prs-unknown: $repo — its open PRs could not be listed this pass"
  fi

  # cancelled is deliberately not red: concurrency groups cancel superseded
  # runs on every push, and a fixer lane for those would chase ghosts.
  #
  # The exit status is read apart from the value, because three unrelated
  # things arrive as an empty `conclusion` and only one of them is news: a run
  # still going (nothing to say yet), a repo with no workflow runs at all
  # (homebrew-tap, .github, scruff-swift — same), and the query failing, which
  # is the shift blind on this repo for the pass. Silence has to mean "looked,
  # and it is not red", or a red main inside a flaky window is reported by
  # omission, and reporting a red main is the whole reason this block exists.
  #
  # ⚠️ A repo with Actions DISABLED lands here too: `gh run list` exits 1 on
  # its 404 rather than returning an empty list, so that repo would be
  # `ci-unknown` on every pass forever. None of hausfold's are today. If one
  # ever is, the answer is an arm that recognises the 404, not a wider `||`.
  #
  # `ci-unknown` carries the reason and draws no trill card: one blip is noise,
  # a rate limit or an expired token is not, and the log is what lets the
  # foreman tell them apart.
  if run_row=$(gh run list -R "hausfold/$repo" -b main -L1 \
    --json conclusion,url -q '.[] | [.conclusion, .url] | @tsv' 2>"$ERRF"); then
    read -r conclusion url <<<"$run_row"
    case "${conclusion:-}" in
    failure | timed_out | startup_failure)
      say "CI-RED: $repo $url"
      notify fault "CI red on $repo main" "$url"
      ;;
    esac
  else
    say "ci-unknown: $repo — main's latest run not read: $(oneline "$(cat "$ERRF")")"
  fi
  conclusion=""; url=""
done

# ── ripple ────────────────────────────────────────────────────────────────────
if [ "$merged" -gt 0 ] && [ "$dry" = 0 ]; then
  if "$ROOT/bench" pull >/dev/null 2>&1 && "$ROOT/bench" ship >/dev/null 2>&1; then
    say "rippled: bench pull + ship after $merged merge(s)"
  else
    say "ripple-failed: bench pull/ship — run it by hand in the morning"
    notify fault "factory: lock ripple failed after $merged merge(s)"
  fi
fi

say "pass done: $merged merged"
# `done` is quoted only because shellcheck reads it as a loop terminator
# (SC1010) otherwise; it is a reserved word in command position alone, so
# nothing was ever broken here.
[ "$merged" -gt 0 ] && notify "done" "factory: merged $merged tier-1 PR(s)"
exit 0
