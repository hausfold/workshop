#!/usr/bin/env bash
# factory-shift — one pass of the night shift: sense, merge what code alone
# can vouch for, report the rest.
#
#   ./script/factory-shift            # act (merges need a live factory-lease)
#   ./script/factory-shift --dry-run  # sense + report only, merge nothing
#
# One pass does four things, in order:
#   budget   read the aiusage pill's own feed (~/.cache/claude-statusline/
#            usage-claude.tsv) and print where the week stands against the
#            pace line — 95% of the weekly window, spent evenly. The script
#            only REPORTS; the foreman (nightshift skill) is what throttles.
#   merge    every open PR in the org through factory-tier; tier 1 + live
#            lease → `gh pr merge --squash`. Anything else is printed with
#            its reason and left for the morning.
#   ripple   if anything merged: `bench pull` then `bench ship`, so the lock
#            edges never sit stale overnight.
#   ci       the latest completed run on each repo's main; red → a CI-RED
#            line (the foreman's cue to spawn a capped fixer lane) and a
#            trill fault card. A run it could not READ is `ci-unknown`, not
#            silence — see the block itself for why that distinction is the
#            difference between a quiet night and an unreported one.
#
# Every line is appended to $STATE_DIR/shift-YYYYMMDD.log — the morning
# report is that file, not a memory of it. Deterministic on purpose: no
# judgement lives here, so what happened while you slept is exactly what
# this file says happens.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="${FACTORY_STATE_DIR:-$HOME/.cache/hausfold-factory}"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/shift-$(date +%Y%m%d).log"
dry=0; [ "${1:-}" = "--dry-run" ] && dry=1

say() { echo "$*"; printf '%s %s\n' "$(date '+%H:%M')" "$*" >>"$LOG"; }
notify() { # notify <kind> <title> [url]
  command -v trill >/dev/null 2>&1 || return 0
  trill send --source factory --kind "$1" --title "$2" ${3:+--url "$3"} >/dev/null 2>&1 || true
}

# ── budget ────────────────────────────────────────────────────────────────────
# Written by haus's modules/ai/statusline-refresh.sh (the aiusage pill's
# feed) — a two-repo artifact with nothing checking agreement, so the
# percentages are sanity-checked before anything trusts them: a column
# reorder over there must degrade this line to "unreadable", never
# mis-throttle the foreman with a number that still happens to parse.
USAGE_TSV="${FACTORY_USAGE_TSV:-$HOME/.cache/claude-statusline/usage-claude.tsv}"
if [ -s "$USAGE_TSV" ]; then
  IFS=$'\t' read -r p5 pw _r5 rw _rest <"$USAGE_TSV"
  now=$(date +%s)
  if ! [ "${p5:-x}" -le 100 ] 2>/dev/null || ! [ "${pw:-x}" -le 100 ] 2>/dev/null; then
    say "budget: unreadable feed at $USAGE_TSV (columns moved?)"
  elif [ "${rw:-0}" -gt "$now" ] 2>/dev/null; then
    line=$((95 * (604800 - (rw - now)) / 604800))
    rel=under; [ "${pw:-0}" -ge "$line" ] 2>/dev/null && rel=OVER
    say "budget: 5h ${p5}% · week ${pw}% vs pace line ${line}% ($rel)"
  else
    say "budget: 5h ${p5:-?}% · week ${pw:-?}% (no reset stamp — pace line unknown)"
  fi
else
  say "budget: unknown — no usage feed at $USAGE_TSV"
fi

# ── lease ─────────────────────────────────────────────────────────────────────
lease_live=0
if lease_line=$("$ROOT/script/factory-lease" status); then lease_live=1; fi
say "$lease_line"
[ "$dry" = 1 ] && say "dry-run: sensing only, merging nothing"

# ── merge + ci, per repo ──────────────────────────────────────────────────────
merged=0
# The org listing is the subject of everything below it. When it fails, the
# loop runs zero times and the pass still ends on "pass done: 0 merged" —
# which is character-for-character what a genuinely quiet night prints. Same
# rule the budget block above already states about itself: degrade to a
# stated unknown, never to an answer that happens to parse. A pass that
# sensed nothing exits non-zero so the foreman cannot read it as a clean one.
if ! repos=$(gh repo list hausfold --no-archived --limit 50 --json name -q '.[].name'); then
  say "pass ABORTED: could not list hausfold's repos — nothing was sensed or merged"
  notify fault "factory: pass aborted, GitHub unreachable"
  exit 1
fi
if [ -z "$repos" ]; then
  say "pass ABORTED: hausfold listed zero repos — refusing to call that a quiet night"
  notify fault "factory: pass aborted, repo list came back empty"
  exit 1
fi
for repo in $repos; do
  while IFS=$'\t' read -r num title; do
    [ -n "$num" ] || continue
    if verdict=$("$ROOT/script/factory-tier" "$repo" "$num" 2>&1); then
      if [ "$dry" = 1 ] || [ "$lease_live" = 0 ]; then
        tag=""; [ "$lease_live" = 0 ] && tag=" (no lease)"
        say "would-merge: $repo#$num $title$tag"
      # Pinned to the head SHA the verdict was computed on: a push landing in
      # the gap makes the merge fail closed to merge-failed, not ride in.
      elif gh pr merge "$num" -R "hausfold/$repo" --squash \
        --match-head-commit "${verdict##*head=}" >/dev/null 2>&1; then
        say "merged: $repo#$num $title"
        merged=$((merged + 1))
      else
        say "merge-failed: $repo#$num — left open"
      fi
    else
      say "queued: $repo#$num $title — ${verdict#tier: not-1 — }"
    fi
  done < <(gh pr list -R "hausfold/$repo" -L 100 --json number,title -q '.[] | [.number, .title] | @tsv')

  # cancelled is deliberately not red: concurrency groups cancel superseded
  # runs on every push, and a fixer lane for those would chase ghosts.
  #
  # The exit status is read apart from the value, because three unrelated
  # things used to arrive here as an empty `conclusion` and all three were
  # equally silent: a run still going (nothing to say yet), a repo with no
  # runs at all (homebrew-tap — same), and **the query itself failing**, which
  # is the shift going blind on this repo for the pass. That last one is not
  # hypothetical: measured 2026-08-29, four `connection reset by peer` and one
  # `http2: client conn could not be established` against api.github.com
  # across three consecutive passes. Silence has to mean "looked, and it is
  # not red", or a red main inside a flaky window is reported by omission —
  # and reporting a red main is the whole reason this block exists.
  #
  # `ci-unknown` is a log line and not a trill card on purpose: one blip is
  # noise, and it is the foreman that decides whether a repeat is a story.
  if run_row=$(gh run list -R "hausfold/$repo" -b main -L1 \
    --json conclusion,url -q '.[] | [.conclusion, .url] | @tsv' 2>/dev/null); then
    read -r conclusion url <<<"$run_row"
    case "${conclusion:-}" in
    failure | timed_out | startup_failure)
      say "CI-RED: $repo $url"
      notify fault "CI red on $repo main" "$url"
      ;;
    esac
  else
    say "ci-unknown: $repo — main's latest run could not be read this pass"
  fi
  conclusion=""; url=""
done

# ── ripple ────────────────────────────────────────────────────────────────────
if [ "$merged" -gt 0 ] && [ "$dry" = 0 ]; then
  if "$ROOT/bench" pull >/dev/null 2>&1 && "$ROOT/bench" ship >/dev/null 2>&1; then
    say "rippled: bench pull + ship after $merged merge(s)"
  else
    say "ripple-failed: bench pull/ship — run it by hand in the morning"
    notify fault "factory: lock ripple failed after $merged merge(s)"
  fi
fi

say "pass done: $merged merged"
[ "$merged" -gt 0 ] && notify "done" "factory: merged $merged tier-1 PR(s)"
exit 0
