#!/usr/bin/env bash
# bench — the workshop CLI for the hausfold family.
#
# The family is a chain of flakes, each pinning the one before it:
#
#   nebelung (theme) ──> pounce (palette app) ──> haus (the nix-darwin layer) ──> ~/.config/nix (your machine)
#                └────────────────────────────────────┘
#
# Editing upstream means nothing until the downstream locks catch up. This
# script exists so you never have to remember that dance:
#
#   bench status    what is this machine RUNNING, and where is everything else?
#                  (local-vs-pinned build, git state, lock edges, release edges,
#                  agent worktrees)
#   bench try       build YOUR machine against the LOCAL checkouts — no pushes
#   bench try switch    …and activate it (still no pushes; prod untouched).
#                  Works from an agent worktree too — that's how you feel-test
#                  one unmerged branch. `bench rebuild` puts the pinned build back.
#   bench try lane [switch]   like `bench try`, but ALSO overrides every repo
#                  a `holt child` spawned from this same pane — the parent
#                  worktree plus its cross-repo lane, built (and optionally
#                  activated) together in one rebuild. Run it from the lane's
#                  parent worktree; no PR needed, unlike try-batch.
#   bench try-batch [switch] [repo…]   build (or activate) EVERY open PR's
#                  branch together on ONE throwaway integration tree per repo —
#                  feel-test the whole review queue in a single rebuild, main
#                  untouched, then merge only the PRs that pass
#   bench ship      push everything in dependency order, rippling lock updates
#   bench rebuild   a plain, pinned rebuild of your machine (the normal day)
#   bench pull [repo…]  fast-forward every repo, or just the named ones
#   bench clone     fetch any family repo missing from this directory
#   bench docs-since   commits in every repo since the docs were last
#                  reconciled (--mark records new watermarks) — the input
#                  to the daily /docs-sync sweep
#   bench release <repo> [version] [--ship]   stamp the version and tag it,
#                  then WATCH the CI run to the end — GitHub release + Homebrew
#                  tap bump (or, for holt, five SDK publishes).
#                  --ship ripples the new lock edge downstream afterwards.
#                  The version is today's date (YYYY.MM.DD, -N on a same-day
#                  repeat) and typed by nobody — EXCEPT for holt, which is
#                  semver because it publishes libraries to registries that
#                  never let a number be taken back: `bench release holt 0.2.0`.
#
# Rule of thumb: hack freely, `bench try` until happy, commit, `bench ship`.
#
# Agent worktrees: agent sessions spawn into git worktrees of the family repos
# (branch `worktree-*`), so parallel agents never fight over a checkout's branch.
# Both try verbs are worktree-aware — run them from inside a worktree and that
# repo's override points at the WORKTREE instead of the main checkout. That
# includes `try switch`: activating ONE unmerged branch is how you feel-test it
# alone (try-batch only ever feels the whole open-PR queue combined, and can't
# see uncommitted work at all). The gate is on WHO, not WHERE — an AI agent is
# refused a worktree switch unless told BENCH_AGENT_SWITCH=1, because activation
# is machine-wide and serial, so parallel agents would silently overwrite each
# other. `bench status` names whatever local code is currently activated (and
# lists agent worktrees + unmerged agent branches); `bench ship` warns about them.
set -euo pipefail

# ROOT is the workshop's MAIN checkout — the dir holding the family repos as
# subdirs. Derive it from the script's git-common-dir, NOT just
# dirname(BASH_SOURCE): a workshop *worktree* checks out its own copy of this
# script, so dirname would point at the worktree (which has NO child repos),
# silently breaking status/ship (an unguarded `git -C <missing>` under `set -e`
# → exit 128, no output). --git-common-dir resolves to the MAIN checkout's .git
# from any linked worktree, so ROOT stays correct however bench was invoked.
# Fall back to the script dir if git can't answer (run outside any checkout).
_bench_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_bench_common="$(git -C "$_bench_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [ -n "$_bench_common" ]; then ROOT="$(dirname "$_bench_common")"; else ROOT="$_bench_dir"; fi
CONSUMER="${HAUS_CONSUMER:-$HOME/.config/nix}"

# Dependency order matters: upstream first, so lock bumps can see pushed revs.
# perch sits before haus: it's a flake input of the platform (which installs it
# via Nix, not Homebrew), so its lock edge ripples downstream like the others.
# holt sits there too — the layer takes it as an input and ships it on PATH, so a
# holt commit is invisible to this machine until haus's lock moves, exactly
# like every other edge here.
#
# FAMILY entries ARE directory names (`local_src` → `$ROOT/$1`), so an entry only
# ever names a repo whose checkout sits at `$ROOT/<entry>` — a repo renamed on
# GitHub without renaming its checkout would have `bench status` reporting one
# repo under the other's name. That is exactly why the 2026-08-11 rename of
# `hausfold/hausfold` → `hausfold/haus` (hausfold-rename.md §10) moves the
# checkout too; `repo_dir` carries a one-release fallback for machines that
# haven't run the `mv` yet.
FAMILY=(nebelung pounce perch holt haus)

# The org every checkout here came from, since the 2026-08-09 transfer. One
# value is right again only because #283 dropped the archived Messages client
# from FAMILY — that repo deliberately stayed behind in the `nebelhaus` org
# (hausfold-rename.md §3.4), and it is the thing to re-check the day any family
# repo *doesn't* travel with the rest. Pair it with `gh_repo` below: a checkout's
# directory name is not always its repo name, and for the rice it isn't.
#
# 🚨 The dead `nebelhaus` org can never be deleted, and that is not housekeeping:
# perch's and pounce's shipped `UpdateCheck.swift` hardcode
# `api.github.com/repos/nebelhaus/<app>/releases/latest`. Every copy already
# installed follows GitHub's redirect — for exactly as long as the org exists.
# Delete it and update checks die silently on machines we'll never hear from.
GH_ORG="hausfold"

# The family repos that are flake INPUTS of the rice, so `overrides()` can point
# them at a local checkout. perch is an Xcode app whose flake wraps a CI-built
# *release* binary (macOS 26 blocks a from-source Nix build), so a plain override
# still installs the last released .app — but for a local SOURCE branch bench
# builds a signed .app in your login session and injects it via the flake's
# `prebuilt` input (see ensure_perch_dev_app), so it feel-tests at source level
# like the pure-Nix repos.
OVERRIDABLE=(nebelung pounce perch holt haus)

# bench try-batch's scratch state. Global (not local to cmd_try_batch) so the
# EXIT trap can still see it: an EXIT trap fires after the function has returned,
# by which point any `local` it captured is already out of scope and empty.
# -gA (not just -A): declare -A inside a function makes the array function-local,
# and bench is *sourced* into a function by the bats harness — so without -g the
# global vanishes and local_src's ${BATCH_SRC[…]:-} tries to read an unbound var.
declare -gA BATCH_SRC=()  # repo → integration-worktree checkout it should build against
BATCH_SCRATCH=""          # the mktemp dir holding those worktrees

# bench try lane's scratch state. Same -g rationale as BATCH_SRC above.
declare -gA LANE_SRC=()   # repo → holt-child checkout it should build against

# ── Palette ──────────────────────────────────────────────────────────────────
# Colour is a courtesy, never load-bearing. Every escape is gated: emitted only
# when stdout is a TTY (so `bench status | less`, CI logs, and the bats harness
# all stay plain) and when NO_COLOR is unset (https://no-color.org); set
# CLICOLOR_FORCE=1 to force it back on through a pipe. When off, every C_* var is
# the empty string, so the exact same printf lines fall back to clean text — and
# alignment is preserved because we only ever colour AROUND pre-padded fields,
# never inside a %-Ns width (an escape counted as width would shear the columns).
# The hues stay in the muted, fog-toned 256-colour range the family already uses.
if { [ -t 1 ] || [ -n "${CLICOLOR_FORCE:-}" ]; } && [ -z "${NO_COLOR:-}" ]; then
  C_OFF=$'\033[0m'
  C_FOG=$'\033[38;5;103m'   # primary accent — the fog itself
  C_OK=$'\033[38;5;108m'    # sage — current / healthy
  C_WARN=$'\033[38;5;179m'  # amber — stale / wants attention
  C_ERR=$'\033[38;5;167m'   # rose — failure
  C_MUT=$'\033[38;5;245m'   # muted grey — secondary detail
  C_REPO=$'\033[38;5;110m'  # soft blue — repo names
else
  C_OFF=; C_FOG=; C_OK=; C_WARN=; C_ERR=; C_MUT=; C_REPO=
fi

say()  { printf '%s🌫  %s%s\n' "$C_FOG" "$*" "$C_OFF"; }
warn() { printf '%s⚠  %s%s\n' "$C_WARN" "$*" "$C_OFF"; }
die()  { printf '%s✗  %s%s\n' "$C_ERR" "$*" "$C_OFF" >&2; exit 1; }
# in-section fix nudge — what to run / be aware of, right under what wants it.
hint() { printf '  %s↳ %s%s\n' "$C_MUT" "$*" "$C_OFF"; }

# Nix's lazy-tree fetcher occasionally leaves a *partial* tree in its cache: the
# commit→tree mapping lands but a blob never finishes fetching (an interrupted
# fetch, a laptop that slept mid-build, two nix runs racing the same cache).
# Every later eval needing that blob dies with the cryptic libgit2 message
# "object not found - no match for id …" — nothing but clearing the cache fixes
# it. The tarball-/fetcher-caches are pure and regenerable, so on that exact
# signature we wipe them and retry once. Mirrors haus/modules/den/haus.sh.
NIX_CACHE_CORRUPT_SIG='no match for id'

nix_cache_wipe() { # drop the regenerable fetch caches for both the user and root nix stores
  warn "corrupt nix fetch cache — clearing it and retrying once (a one-time re-fetch) …"
  rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}"/nix/tarball-cache* \
         "${XDG_CACHE_HOME:-$HOME/.cache}"/nix/fetcher-cache*.sqlite 2>/dev/null || true
  # `darwin-rebuild switch` evaluates as root, so its cache is a separate store
  # under /var/root — needs sudo to clear (creds are usually still warm from the
  # switch we just ran; worst case it's one password prompt on the recovery path).
  sudo rm -rf /var/root/.cache/nix/tarball-cache* \
              /var/root/.cache/nix/fetcher-cache*.sqlite 2>/dev/null || true
}

heal() { # run "$@"; on the cache-corruption signature, wipe the caches and retry once
  local log rc
  log="$(mktemp)"
  if "$@" 2>&1 | tee "$log"; then rc=0; else rc=${PIPESTATUS[0]}; fi
  if [ "$rc" -ne 0 ] && grep -qF "$NIX_CACHE_CORRUPT_SIG" "$log"; then
    rm -f "$log"
    nix_cache_wipe
    "$@"; return $?
  fi
  rm -f "$log"
  return "$rc"
}

repo_dir() { # repo_dir <name> — family repos live under ROOT; consumer + workshop elsewhere
  case "$1" in
    consumer) echo "$CONSUMER" ;;   # ~/.config/nix, outside the workshop dir
    workshop) echo "$ROOT" ;;       # the workshop IS ROOT, not ROOT/workshop
    *)        echo "$ROOT/$1" ;;
  esac
}

# repo_dir's counterpart: repo_dir maps a name to a LOCAL directory, gh_repo maps
# the same name to the REMOTE it came from. They agree for most of the family and
# must not be assumed to.
#
# 🚨 Every arm below exists because a redirect would otherwise paper over the
# mismatch, and a redirect is the wrong thing to lean on here. `hausfold/nebelhaus`
# resolves today — GitHub keeps every pre-rename name pointed at `hausfold/haus`
# — so a bare "$GH_ORG/$name" appears to work, right up until someone creates a
# repo actually named `hausfold/nebelhaus`. That is not hypothetical: the rice
# KEEPS the name nebelhaus (hausfold-rename.md §6), so that name is live and
# spoken-for in this org. The day it becomes a real repo, every `gh pr list` and
# `git clone` below silently retargets it, with no error anywhere. The same now
# goes for the freed slug `hausfold/hausfold` (§10).
gh_repo() { # gh_repo <name> — the owner/repo a workshop checkout came from
  case "$1" in
    # (The layer needs no arm: since §10 its checkout is ./haus and its repo is
    # `hausfold/haus`, so it falls out of the default below like everyone else.)
    # GitHub's org front page lives in a repo that must be named `.github`; the
    # checkout can't be, because a dotdir there is invisible and collides with
    # this repo's own ./.github. This arm used to be inline in cmd_clone.
    org-profile) echo "$GH_ORG/.github" ;;
    *)           echo "$GH_ORG/$1" ;;
  esac
}

head_rev() { git -C "$(repo_dir "$1")" rev-parse HEAD 2>/dev/null || echo "?"; }

locked_rev() { # locked_rev <repo> <input> — what rev <repo>'s flake.lock pins <input> at
  python3 - "$(repo_dir "$1")/flake.lock" "$2" <<'EOF'
import json, sys
try:
    lock = json.load(open(sys.argv[1]))
    print(lock["nodes"][sys.argv[2]]["locked"]["rev"])
except Exception:
    print("?")
EOF
}

# rev_on_main <repo> <rev> — is <rev> an ancestor of that repo's main?
#
# A lock is normally bumped to a MERGED rev, so this is yes and nobody thinks
# about it. It answers `no` when a lock was pinned at a rev that lives only on
# an unmerged PR branch — which a hand-run `nix flake update` inside a PR
# produces, and `bench ship` cannot (it only ever bumps to merged HEADs). That
# pin resolves today and stops resolving the moment the branch is deleted, which
# GitHub does by default on merge: the downstream repo then cannot fetch its own
# input at all. Nothing else in the family notices, because the rev is real, the
# hash matches, and every build is cached.
#
# `unknown` is a separate answer on purpose: a rev nix fetched but git never did
# isn't IN the local clone, so ancestry can't be decided here and saying `no`
# would cry wolf on every machine that hasn't fetched. Checked against
# origin/main AND local main, so a checkout behind its remote doesn't report a
# landed rev as off-main. HEAD is only consulted when NEITHER resolves (a repo
# whose default branch isn't `main`): every extra ref widens the "yes" set, so
# reading HEAD unconditionally would let a main checkout parked on a branch —
# the in-place agent mode does exactly that — declare every rev on that branch
# landed, silencing the warning precisely where it's most likely to be earned.
rev_on_main() {
  local dir rev ref refs=()
  dir="$(repo_dir "$1")"; rev="$2"
  case "$rev" in ''|'?') echo unknown; return ;; esac   # locked_rev's own failure value
  [ -d "$dir/.git" ] || { echo unknown; return; }
  git -C "$dir" cat-file -e "${rev}^{commit}" 2>/dev/null || { echo unknown; return; }
  for ref in origin/main main; do
    git -C "$dir" rev-parse --verify --quiet "$ref" >/dev/null 2>&1 && refs+=("$ref")
  done
  [ "${#refs[@]}" -gt 0 ] || refs=(HEAD)
  for ref in "${refs[@]}"; do
    git -C "$dir" merge-base --is-ancestor "$rev" "$ref" 2>/dev/null && { echo yes; return; }
  done
  echo no
}

# The lock edges of the family graph: "<consumer-repo> <input-name> <source-repo>"
EDGES=(
  "pounce nebelung nebelung"
  "haus nebelung nebelung"
  "haus pounce pounce"
  "haus perch perch"
  "haus holt holt"
  "consumer nebelhaus haus"
)

host_name() { # the darwinConfiguration to build in the consumer flake
  if [ -n "${HAUS_HOST:-}" ]; then echo "$HAUS_HOST"; return; fi
  nix eval --json "$CONSUMER#darwinConfigurations" --apply builtins.attrNames 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)[0])' 2>/dev/null \
    || hostname -s
}

# If we're running from inside a LINKED worktree of a family repo (a Claude
# agent's isolated checkout), note which repo and where. Works wherever the
# worktree physically lives: --git-common-dir always points at the main
# checkout's .git, and a linked worktree is exactly "toplevel != main".
WT_REPO="" WT_PATH=""
detect_worktree() {
  local top common main name
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  main="$(dirname "$common")"
  [ "$top" = "$main" ] && return 0
  for name in "${FAMILY[@]}"; do
    if [ "$main" = "$(repo_dir "$name")" ]; then WT_REPO="$name" WT_PATH="$top"; return 0; fi
  done
}

local_src() { # local_src <repo> — the checkout to build against (batch- + lane- + worktree-aware)
  # A try-batch integration tree wins over everything: it's the combined
  # main+PRs checkout we deliberately built for this repo. Next, a lane child
  # (bench try lane populated LANE_SRC for every holt-child repo). Otherwise
  # fall through to the active agent worktree (if this repo is it), then the
  # main checkout.
  if [ -n "${BATCH_SRC[$1]:-}" ]; then echo "${BATCH_SRC[$1]}"; return; fi
  if [ -n "${LANE_SRC[$1]:-}" ]; then echo "${LANE_SRC[$1]}"; return; fi
  if [ "$1" = "$WT_REPO" ]; then echo "$WT_PATH"; else repo_dir "$1"; fi
}

# bench try lane: build+activate a whole holt lane together — this pane's own
# worktree (already handled by WT_REPO/WT_PATH above) PLUS every `holt child`
# worktree spawned from it, however many repos it touches. holt's registry
# only records a one-hop parent pointer per row (the spawning pane's own
# checkout path) — never a children list, deliberately (that's holt's own
# scope boundary). So the walk lives here: read every row, and starting from
# THIS pane's checkout, transitively pull in any row whose `parent` matches a
# path already found — a child's child included, not just direct children.
#
# lane_paths prints one checkout path per line: self, then every descendant,
# BFS order. A `seen` set makes it cycle-safe even though holt shouldn't ever
# produce one (a child's parent is strictly an earlier pane).
lane_paths() { # lane_paths <self-checkout-path>
  local self="$1"
  [ -f "$WT_REGISTRY" ] || { echo "$self"; return; }
  awk -F'\t' -v self="$self" '
    { main[$4] = $2; parent[$4] = $5 }
    END {
      queue[1] = self; n = 1; seen[self] = 1
      for (i = 1; i <= n; i++) {
        cur = queue[i]
        for (path in parent) {
          if (parent[path] == cur && !(path in seen)) {
            seen[path] = 1; n++; queue[n] = path
          }
        }
      }
      for (i = 1; i <= n; i++) print queue[i]
    }
  ' "$WT_REGISTRY"
}

detect_lane() { # populate LANE_SRC with every holt-child of THIS pane's worktree
  local self path row_main name
  self="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  while IFS= read -r path; do
    [ -n "$path" ] && [ "$path" != "$self" ] || continue   # self is WT_REPO/WT_PATH already
    row_main="$(awk -F'\t' -v p="$path" '$4 == p { print $2; exit }' "$WT_REGISTRY" 2>/dev/null)"
    [ -n "$row_main" ] || continue
    for name in "${FAMILY[@]}"; do
      [ "$row_main" = "$(repo_dir "$name")" ] && { LANE_SRC["$name"]="$path"; break; }
    done
  done < <(lane_paths "$self")
}

# ── who is driving? ─────────────────────────────────────────────────────────
# Activation is the one bench verb that changes THIS machine's running state,
# and it's serial — one darwin-rebuild switch = one machine. That makes it a
# *human's* call, not because worktree code is dangerous (it isn't; the build
# is identical either way) but because N agents in N parallel panes each have
# an equally good reason to activate, and the last one silently wins.
#
# So the gate is on WHO, not WHERE: a person at the keyboard may `bench try
# switch` from anywhere, including an agent worktree. An agent may not do it
# from a worktree unprompted — it should hand the command back to the human,
# or be told explicitly (BENCH_AGENT_SWITCH=1) that this time it's wanted.
# This is a reminder, not a jail: an agent that's been told to activate sets
# the variable and moves on.
agent_driving() { # true when an AI coding agent is the one running bench
  [ -n "${AI_AGENT:-}${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CODEX_SANDBOX:-}${OPENCODE:-}${OPENCODE_BIN_PATH:-}" ]
}

overrides() { # every family input redirected at the local checkouts
  # perch can't build from source in Nix (macOS 26 walls off the _nixbld user —
  # see ensure_perch_dev_app), so when there's local SOURCE to test we hand its
  # flake a login-session-built .app via the `prebuilt` input. Empty otherwise →
  # the flake wraps the release, unchanged.
  #
  # 🚨 Every `nebelhaus` below is a FLAKE INPUT NAME, not a repo — it is what
  # ~/.config/nix's flake calls its input (`inputs.nebelhaus.url`), and the rice
  # keeps that name (hausfold-rename.md §6). Do NOT "finish the rename" here:
  # renaming these addresses an input that doesn't exist, and every override
  # silently stops applying — with no error, because a `--override-input` for an
  # unknown input is not a hard failure. `bench try` would report that it built
  # your branch while building the pinned rice.
  #
  # The ONE token here that is a directory is `local_src`'s argument: §3.3's
  # step 4 moved it to `hausfold` and §10 moved it again to `haus`, each time in
  # the commit that renamed the checkout. The `nebelhaus/…` input paths stayed
  # exactly as they were through both, which is what makes this line the
  # clearest illustration of the rule — the input name and the directory are
  # different things and only one of them ever moves.
  local perch_prebuilt=""
  [ -n "$PERCH_DEV_APP_DIR" ] \
    && perch_prebuilt=" --override-input nebelhaus/perch/prebuilt path:$PERCH_DEV_APP_DIR"
  echo "--override-input nebelhaus path:$(local_src haus) \
        --override-input nebelhaus/nebelung path:$(local_src nebelung) \
        --override-input nebelhaus/pounce path:$(local_src pounce) \
        --override-input nebelhaus/perch path:$(local_src perch)$perch_prebuilt \
        --override-input nebelhaus/holt path:$(local_src holt)"
}

# perch is the one family repo Nix can't build from source: it's an Xcode project
# whose SwiftPM manifest sandbox macOS 26 refuses to let the session-less _nixbld
# build user apply, so a from-source derivation dies at package resolution
# (pounce dodges this only by being plain `swiftc`). So when `bench try`/`try-batch` has
# local perch SOURCE to feel-test (an agent worktree, or a batch integration
# tree), build Perch.app HERE in your login session — where xcodebuild works —
# and inject it into the flake via its `prebuilt` input (see the perch repo).
# Idempotent per run; a no-op when perch's source is just the pinned main
# checkout (then the flake wraps the release as always).
PERCH_DEV_APP_DIR=""
ensure_perch_dev_app() {
  local src; src="$(local_src perch)"
  [ "$src" = "$ROOT/perch" ] && return 0             # no local perch source → release
  [ -n "$PERCH_DEV_APP_DIR" ] && return 0            # already built this run
  [ -f "$src/Perch.xcodeproj/project.pbxproj" ] || return 0

  # A STABLE signing identity so any permission grant the dev build is given
  # persists across rebuilds — ad-hoc/unsigned changes identity every build and
  # macOS would re-prompt each time. Prefer Developer ID (needs no provisioning
  # profile); fall back to an Apple Development cert.
  local ident
  ident="$(security find-identity -v -p codesigning 2>/dev/null \
             | sed -n 's/.*"\(Developer ID Application[^"]*\)".*/\1/p' | head -1)"
  [ -n "$ident" ] || ident="$(security find-identity -v -p codesigning 2>/dev/null \
             | sed -n 's/.*"\(Apple Development[^"]*\)".*/\1/p' | head -1)"
  [ -n "$ident" ] || die "perch dev build needs a stable signing identity (Developer ID or Apple Development) in your keychain so its permission grants survive rebuilds — open Xcode once to create one."

  # A `<version>-dev` marketing version so Perch's About window reads e.g.
  # "2026.07.26-dev" at a glance — otherwise it shows the stale MARKETING_VERSION
  # baked into project.pbxproj and you can't tell the dev build from the release.
  local ver; ver="$(tr -d '[:space:]' < "$src/VERSION" 2>/dev/null || true)"
  [ -n "$ver" ] && ver="${ver}-dev" || ver="dev"

  # Persistent DerivedData → incremental rebuilds; a real (non-symlinked) temp dir
  # for the .app because Nix's path: fetcher rejects a symlinked component (/tmp
  # is a symlink on macOS, so mktemp there breaks — hence pwd -P).
  local dd="${XDG_CACHE_HOME:-$HOME/.cache}/bench/perch-dd"
  local out; out="$(cd "$(mktemp -d "${TMPDIR:-/private/tmp}/bench-perch-dev.XXXXXX")" && pwd -P)"
  mkdir -p "$dd"

  say "perch: building a signed dev app from $src"
  say "       (bundle com.hausfold.perch.dev, version $ver, $ident) — first run is slow…"
  if ! ( cd "$src" && /usr/bin/xcodebuild \
           -project Perch.xcodeproj -scheme Perch -configuration Debug \
           -destination 'platform=macOS' -derivedDataPath "$dd" \
           PRODUCT_BUNDLE_IDENTIFIER=com.hausfold.perch.dev \
           MARKETING_VERSION="$ver" \
           CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="$ident" \
           build >/dev/null ); then
    die "perch dev build failed — re-run that xcodebuild in $src by hand to see why."
  fi
  /usr/bin/ditto "$dd/Build/Products/Debug/Perch.app" "$out/Perch.app"
  PERCH_DEV_APP_DIR="$out"
  say "perch: dev app built (com.hausfold.perch.dev); its stable identity keeps"
  say "       any permission grant it's given across future dev builds."
}

# Release bookkeeping. Releases are what users actually consume — pounce via
# the Homebrew tap, the rice via nebelhaus.com/init.sh (which serves the
# LATEST RELEASE's bootstrap, not main) — so a tag that falls behind main is
# every bit as stale as a lock edge, just invisible without this.
latest_tag() { # latest_tag <repo> — newest v* tag by version order, "" if none
  git -C "$(repo_dir "$1")" tag --list 'v*' --sort=-v:refname 2>/dev/null | head -1
}
commits_since() { # commits_since <repo> <tag> — user-facing commits on HEAD the tag lacks
  # Discount the release bot's own commits. perch wraps a notarized ZIP, so its
  # release.yml `bump-flake` job rewrites nix/release.nix with that ZIP's sha256
  # in a commit pushed AFTER the tag — a pin can't predate the artifact it hashes,
  # so it sits 1 commit past the latest tag forever without being new work. Left
  # in, it flags every freshly-released perch as "1 commit behind main" for good.
  local dir; dir="$(repo_dir "$1")"
  local total; total="$(git -C "$dir" rev-list --count "$2..HEAD" 2>/dev/null)" || { echo "?"; return; }
  local bot; bot="$(git -C "$dir" rev-list --count --author='haus-release' "$2..HEAD" 2>/dev/null || echo 0)"
  echo "$(( total - bot ))"
}

# Agent worktree bookkeeping, shared by status + ship.
list_worktrees() { # list_worktrees <repo> — linked worktree paths, one per line
  git -C "$(repo_dir "$1")" worktree list --porcelain 2>/dev/null \
    | awk '$1 == "worktree" { print $2 }' | tail -n +2
}
unmerged_agent_branches() { # worktree-* branches not merged into the current HEAD
  git -C "$(repo_dir "$1")" branch --list 'worktree-*' --no-merged HEAD \
    --format='%(refname:short)' 2>/dev/null
}
# The registry `holt` (and frozen `wt`) both write: one tab-separated row per
# worktree, name \t repo \t branch \t checkout \t parent \t agent. It is the ONLY
# thing that knows a branch is a real, resumable session — a bare `worktree-*`
# name proves nothing. `--no-merged` can't see a SQUASH merge, so a landed PR's
# branch looks unmerged forever, and a CLOSED PR's branch never merges at all;
# both used to be printed as "parked", telling you to resume a session that
# holt correctly reports doesn't exist. Registry says no row → it's a corpse.
WT_REGISTRY="${CLAUDE_WT_BASE:-$HOME/.cache/claude-worktrees}/registry.tsv"
branch_is_parked() { # branch_is_parked <repo> <branch> — has a registry row?
  [ -f "$WT_REGISTRY" ] || return 1
  awk -F'\t' -v r="$(repo_dir "$1")" -v b="$2" \
    '$2 == r && $3 == b { found = 1; exit } END { exit !found }' "$WT_REGISTRY"
}

status_running() { # the receipt a `try switch` left — FIRST section, because it
                   # outranks every lock edge below: when it fires, the locks
                   # describe a machine you are not currently running.
  local body
  if ! body="$(read_activation)"; then
    say "running the pinned build — the lock edges below describe this machine"
    echo
    return 0
  fi
  local repo src branch dirty when="" gone=0
  when="$(printf '%s\n' "$body" | sed -n 's/^when\t//p')"
  warn "running LOCAL code — activated ${when:-at an unknown time}. The lock edges below do NOT describe this machine."
  printf '  %s%-12s %-32s %-6s %s%s\n' "$C_MUT" "repo" "branch" "tree" "built from" "$C_OFF"
  while IFS=$'\t' read -r repo src branch dirty; do
    case "$repo" in when|host|system|'') continue ;; esac
    local where="$src" dcol="$C_MUT"
    [ "$dirty" = dirty ] && dcol="$C_WARN"
    if [ ! -d "$src" ]; then where="$src  (gone)"; gone=1; fi
    # Clamp the branch so one long agent name can't shear the columns — the
    # same rule the release watch's job names follow.
    [ "${#branch}" -gt 32 ] && branch="${branch:0:31}…"
    local repo_c branch_c dirty_c
    printf -v repo_c '%-12s' "$repo"; printf -v branch_c '%-32s' "$branch"
    printf -v dirty_c '%-6s' "$([ "$dirty" = dirty ] && echo dirty || echo '·')"
    printf '  %s%s%s %s %s%s%s %s%s%s\n' \
      "$C_REPO" "$repo_c" "$C_OFF" "$branch_c" \
      "$dcol" "$dirty_c" "$C_OFF" "$C_MUT" "$where" "$C_OFF"
  done <<<"$body"
  [ "$gone" = 1 ] && hint "a source checkout is gone (worktree reaped) — the running system itself is safe (the system profile GC-roots it), but nothing can rebuild it from source any more"
  hint "bench rebuild returns to the pinned build · land the branch via its PR, then bench ship, to make this reproducible"
  echo
}

cmd_status() {
  status_running
  say "repos"
  printf '  %s%-12s %-8s %-7s %s%s\n' "$C_MUT" "repo" "branch" "dirty" "vs origin" "$C_OFF"
  local any_dirty=0 any_ahead=0 any_behind=0
  for name in "${FAMILY[@]}" consumer; do
    local dir; dir="$(repo_dir "$name")"
    [ -d "$dir/.git" ] || { printf '  %s%-12s%s %s(missing — bench clone)%s\n' \
      "$C_REPO" "$name" "$C_OFF" "$C_MUT" "$C_OFF"; continue; }
    local branch dirty ahead behind
    branch="$(git -C "$dir" branch --show-current)"
    dirty="$(git -C "$dir" status --porcelain | wc -l | tr -d ' ')"
    [ "$dirty" = "0" ] && dirty="·" || dirty="${dirty} files"
    git -C "$dir" fetch -q --tags 2>/dev/null || true
    ahead="$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo '?')"
    behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')"
    # Pre-pad each cell, THEN wrap in colour, so widths hold with or without ANSI.
    # Clean tree → sage dot; dirty → amber count. Unpushed (↑) / behind (↓) glow
    # amber only when non-zero, so a synced repo reads as a quiet row of zeros.
    local repo_c dirty_c; printf -v repo_c '%-12s' "$name"; printf -v dirty_c '%-7s' "$dirty"
    local dcol="$C_OK"; [ "$dirty" = "·" ] || { dcol="$C_WARN"; any_dirty=1; }
    local acol="$C_MUT"; [ "$ahead"  = "0" ] || { acol="$C_WARN"; any_ahead=1; }
    local bcol="$C_MUT"; [ "$behind" = "0" ] || { bcol="$C_WARN"; any_behind=1; }
    printf '  %s%s%s %-8s %s%s%s %s↑%s%s %s↓%s%s\n' \
      "$C_REPO" "$repo_c" "$C_OFF" "$branch" \
      "$dcol" "$dirty_c" "$C_OFF" \
      "$acol" "$ahead" "$C_OFF" "$bcol" "$behind" "$C_OFF"
  done
  [ "$any_dirty"  = 1 ] && hint "dirty: commit in that repo (bench ship refuses a dirty tree)"
  [ "$any_ahead"  = 1 ] && hint "↑ unpushed: bench ship (pushes, then ripples the locks downstream)"
  [ "$any_behind" = 1 ] && hint "↓ behind origin: bench pull <repo> (or bare bench pull for all)"

  # Agent worktrees + their branches — only speak up if any exist.
  local wt_lines="" any_stale=0
  for name in "${FAMILY[@]}"; do
    local wt branch dirty
    while IFS= read -r wt; do
      [ -n "$wt" ] || continue
      branch="$(git -C "$wt" branch --show-current 2>/dev/null || echo '?')"
      local dcol; dcol="$([ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ] && printf '%s' "$C_WARN" || printf '%s' "$C_MUT")"
      dirty="$([ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ] && echo 'dirty' || echo '·')"
      local repo_c dirty_c; printf -v repo_c '%-12s' "$name"; printf -v dirty_c '%-6s' "$dirty"
      wt_lines+="$(printf '  %s%s%s %-24s %s%s%s %s%s%s' \
        "$C_REPO" "$repo_c" "$C_OFF" "$branch" \
        "$dcol" "$dirty_c" "$C_OFF" "$C_MUT" "$wt" "$C_OFF")"$'\n'
    done <<<"$(list_worktrees "$name")"
    local b
    for b in $(unmerged_agent_branches "$name"); do
      # branches whose worktree is gone but whose commits aren't merged yet
      if ! git -C "$(repo_dir "$name")" worktree list --porcelain | grep -q "branch refs/heads/$b"; then
        local repo_c note; printf -v repo_c '%-12s' "$name"
        if branch_is_parked "$name" "$b"; then
          note="(parked — 'holt ${b#worktree-}' to resume, or open a PR / delete)"
        else
          any_stale=1
          note="(stale branch — no checkout, no registry row; open a PR or delete)"
        fi
        wt_lines+="$(printf '  %s%s%s %-24s %s·      %s%s%s%s' \
          "$C_REPO" "$repo_c" "$C_OFF" "$b" "$C_MUT" "$C_OFF" "$C_MUT" "$note" "$C_OFF")"$'\n'
      fi
    done
  done
  if [ -n "$wt_lines" ]; then
    echo
    say "agent worktrees (isolated Claude checkouts; open a PR to land — never push to main)"
    printf '  %s%-12s %-24s %-6s %s%s\n' "$C_MUT" "repo" "branch" "dirty" "where" "$C_OFF"
    printf '%s' "$wt_lines"
    # shellcheck disable=SC2016  # backticks are literal markdown, not command substitution
    printf '  %s↳ landed ones linger if a pane was killed without the remove hook — sweep them with `holt reap`%s\n' "$C_MUT" "$C_OFF"
    # shellcheck disable=SC2016
    [ "$any_stale" = 1 ] && printf '  %s↳ stale branches outlived their PR (squash-merged, or closed) — `git -C <repo> branch -D <branch>`%s\n' "$C_MUT" "$C_OFF"
  fi

  echo
  say "lock edges (is anyone consuming an old version of anyone?)"
  local stale=0 offmain=0
  for edge in "${EDGES[@]}"; do
    read -r holder input source <<<"$edge"
    local want have label
    want="$(head_rev "$source")"
    have="$(locked_rev "$holder" "$input")"
    label="$holder → $input"
    [ "$holder" = "consumer" ] && label="you → $input"
    if [ "$have" = "$want" ]; then
      printf '  %s✓%s %-22s %scurrent%s (%s%s%s)\n' \
        "$C_OK" "$C_OFF" "$label" "$C_MUT" "$C_OFF" "$C_MUT" "${have:0:7}" "$C_OFF"
    elif [ "$(rev_on_main "$source" "$have")" = "no" ]; then
      # Worse than stale, and a different fix. `bench ship` is not a no-op here
      # — it repins to the upstream's main HEAD like any other edge — but that
      # SILENTLY DROPS the unmerged work this lock was pinned at, which is
      # nobody's intent when the pin was deliberate. So report it as its own
      # thing rather than letting it wear STALE's "just ship it" hint.
      printf '  %s⚠%s %-22s %sOFF-MAIN%s: locked %s%s%s is not on %s'"'"'s main, local %s%s%s\n' \
        "$C_WARN" "$C_OFF" "$label" "$C_WARN" "$C_OFF" \
        "$C_WARN" "${have:0:7}" "$C_OFF" "$source" "$C_OK" "${want:0:7}" "$C_OFF"
      offmain=1
    else
      printf '  %s⚠%s %-22s %sSTALE%s: locked %s%s%s, local %s%s%s\n' \
        "$C_WARN" "$C_OFF" "$label" "$C_WARN" "$C_OFF" \
        "$C_MUT" "${have:0:7}" "$C_OFF" "$C_OK" "${want:0:7}" "$C_OFF"
      stale=1
    fi
  done
  [ "$stale" = 1 ] && hint "STALE: bench ship (if the upstream work is committed) · bench try to feel it locally first, nothing pushed"
  [ "$offmain" = 1 ] && hint "OFF-MAIN: that rev lives on an unmerged branch — it stops resolving the moment the branch is deleted on merge, and the downstream repo then can't fetch its input at all. Land the upstream PR, then \`bench ship\` re-pins at the merge commit. Shipping FIRST also works and is usually wrong: it repins to main and silently drops the unmerged work."
  echo
  say "release edges (what new users actually get)"
  local rel_stale=0
  for name in pounce perch haus holt; do
    local dir tag behind audience cut
    dir="$(repo_dir "$name")"
    [ -d "$dir/.git" ] || continue
    case "$name" in
      pounce)    audience="brew installs" ;;
      perch)     audience="brew + the rice's flake pin" ;;
      haus)      audience="nebelhaus.com/init.sh (the rice)" ;;
      # holt is the only one whose release lands OUTSIDE our own infrastructure:
      # five SDKs on npm/PyPI/crates/SwiftPM/the Go proxy. The rice pins holt's
      # main, so this machine sees a holt commit via the lock edge above — but
      # everyone consuming an SDK sees only what was last released.
      holt)      audience="npm/PyPI/crates/SwiftPM/go get" ;;
    esac
    # CalVer needs no argument; holt is semver, so the number is a judgement.
    cut="bench release $name"
    [ "$(version_scheme "$name")" = semver ] && cut="bench release $name <X.Y.Z>"
    tag="$(latest_tag "$name")"
    if [ -z "$tag" ]; then
      # holt is the one repo where "no tag" doesn't mean "consumers see main":
      # its SDKs are already live at 0.1.0, hand-published before this flow
      # existed, and nothing moves them until a tag does.
      local nofallback="falls back to main"
      [ "$name" = holt ] && nofallback="stays on whatever was last published by hand"
      printf '  %s⚠%s %-22s no release yet — %s %s\n' \
        "$C_WARN" "$C_OFF" "$name" "$audience" "$nofallback"
      printf '      %scut the first release: %s%s\n' "$C_MUT" "$cut" "$C_OFF"
      rel_stale=1
      continue
    fi
    behind="$(commits_since "$name" "$tag")"
    if [ "$behind" = "0" ]; then
      printf '  %s✓%s %-22s %s%s%s is current with main\n' \
        "$C_OK" "$C_OFF" "$name" "$C_OK" "$tag" "$C_OFF"
    else
      printf '  %s⚠%s %-22s %s%s%s is %s%s%s commit(s) behind main — %s get the old one\n' \
        "$C_WARN" "$C_OFF" "$name" "$C_MUT" "$tag" "$C_OFF" "$C_WARN" "$behind" "$C_OFF" "$audience"
      # release stamps the version itself; nothing to bump by hand first.
      printf '      %scut a release: %s%s\n' "$C_MUT" "$cut" "$C_OFF"
      rel_stale=1
    fi
  done

  echo
  # OFF-MAIN ranks above STALE: a stale lock is behind, an off-main one is
  # pinned at something that may stop existing. Ranking it below would let
  # "everything is current" be the closing verdict on a repo that is one branch
  # deletion away from not evaluating.
  if [ "$offmain" = "1" ]; then
    warn "a lock edge is pinned OFF-MAIN above — land that upstream PR before anything else ships."
  elif [ "$stale" = "1" ]; then
    warn "stale lock edges above — see the ↳ fix under that section."
  elif [ "$rel_stale" = "1" ]; then
    warn "locks are current, but a release is behind — ship is done, releasing is the last mile (↳ above)."
  else
    say "everything is current. The fog is even."
  fi
}

# ── activating what we already built ────────────────────────────────────────
# Every switch below has ALREADY built the system into $CONSUMER/result. The
# obvious `darwin-rebuild switch --flake` would then build it a SECOND time as
# root, against root's own eval + lazy-trees caches under /var/root/.cache/nix —
# same store, same result. Measured on mbp: ~3 s wasted after a plain edit, and
# ~15 s whenever a flake input moved, because root re-unpacks nixpkgs' nixexprs
# into its own git cache right after your user-side eval unpacked it into yours.
# With `overrides` in play that second eval is the expensive one, since it walks
# the local checkouts too.
#
# `haus-activate` (shipped by the layer — haus/modules/den) does only the
# privileged half: set the system profile, then run that build's own
# `darwin-rebuild activate`. Both routes go through a stable
# /run/current-system path, never ./result or a store path: collar's
# passwordless-sudo rule matches a literal path, because sudo ≥1.9.17 no longer
# follows the command symlink.
#
# The fallback is for a machine whose running system predates haus-activate —
# including, notably, the very rebuild that installs it.
activate_built() {
  local host="$1"
  if [ -x /run/current-system/sw/bin/haus-activate ]; then
    sudo /run/current-system/sw/bin/haus-activate "$CONSUMER/result"
  else
    # shellcheck disable=SC2046
    (cd "$CONSUMER" && heal sudo /run/current-system/sw/bin/darwin-rebuild switch --flake ".#$host" $(overrides))
  fi
}

# ── what is this machine actually running? ──────────────────────────────────
# A `try switch` puts unpushed code on the machine. That's the point — testing
# in prod is house style — but the fact then lives only in the scrollback of the
# pane that did it, and panes die. THAT is the real hazard the old
# worktree-refusal was groping at: not "worktree code is unsafe" (it isn't — the
# derivation is identical wherever the source sits) but "you can't tell, an hour
# later, that this machine isn't running what its flake.lock says".
#
# So every activation writes a receipt and `bench status` reads it back. The
# receipt PINS THE SYSTEM STORE PATH it described, so it can't lie: a later
# `haus rollback`, a plain `bench rebuild`, or anyone else's switch moves
# /run/current-system, the paths stop matching, and the receipt is discarded as
# stale instead of nagging about a build that's no longer running. No receipt
# (or a stale one) IS the "running the pinned build" state.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bench"
ACTIVE_FILE="$STATE_DIR/activated"

current_system() { readlink /run/current-system 2>/dev/null || true; }

record_activation() { # record_activation <host> — snapshot which sources went live
  local host="$1" repo src line body=""
  for repo in "${OVERRIDABLE[@]}"; do
    src="$(local_src "$repo")"
    local branch dirty
    branch="$(git -C "$src" branch --show-current 2>/dev/null || echo '?')"
    [ -n "$branch" ] || branch="(detached)"
    # A try-batch integration tree is detached by construction and its scratch
    # dir is gone by the time anyone reads this back, so name what it MEANT.
    [ -n "${BATCH_SRC[$repo]:-}" ] && branch="batch: main + open PRs"
    dirty="$([ -n "$(git -C "$src" status --porcelain 2>/dev/null)" ] && echo dirty || echo clean)"
    # Only worth recording if it isn't the pinned main checkout on a clean main
    # branch — otherwise a `try switch` from a spotless workshop would leave a
    # receipt that says nothing and a status that cries wolf.
    if [ "$src" = "$ROOT/$repo" ] && [ "$dirty" = clean ] \
       && { [ "$branch" = main ] || [ "$branch" = master ]; }; then continue; fi
    printf -v line '%s\t%s\t%s\t%s' "$repo" "$src" "$branch" "$dirty"
    body+="$line"$'\n'
  done
  if [ -z "$body" ]; then rm -f "$ACTIVE_FILE"; return 0; fi
  mkdir -p "$STATE_DIR"
  { printf 'when\t%s\n' "$(date '+%Y-%m-%d %H:%M')"
    printf 'host\t%s\n' "$host"
    printf 'system\t%s\n' "$(current_system)"
    printf '%s' "$body"; } >"$ACTIVE_FILE"
}

clear_activation() { rm -f "$ACTIVE_FILE"; }

# read_activation — echo the receipt verbatim, but ONLY while it still describes
# the running system. Returns 1 (and silently reaps the stale file) otherwise, so
# every caller gets the same answer. It emits the header lines too rather than
# setting globals: callers read it through $(…), and a subshell can't hand a
# variable back — a header line CAN cross that boundary.
read_activation() {
  [ -f "$ACTIVE_FILE" ] || return 1
  local recorded
  recorded="$(sed -n 's/^system\t//p' "$ACTIVE_FILE")"
  # An empty `system` means the switch predated this field — trust it rather
  # than throw it away; anything else must still be what's mounted.
  if [ -n "$recorded" ] && [ "$recorded" != "$(current_system)" ]; then
    clear_activation; return 1
  fi
  cat "$ACTIVE_FILE"
}

active_banner() { # the loud "you are running unpushed code" block, post-switch
  local body; body="$(read_activation)" || return 0
  local repo src branch dirty
  warn "this machine is now running LOCAL code, not what any flake.lock pins:"
  while IFS=$'\t' read -r repo src branch dirty; do
    case "$repo" in when|host|system|'') continue ;; esac
    printf '      %s%-10s%s %s %s(%s)%s\n' \
      "$C_REPO" "$repo" "$C_OFF" "$branch" "$C_MUT" "$dirty" "$C_OFF"
  done <<<"$body"
  hint "bench status will keep saying so · bench rebuild returns to the pinned build"
}

cmd_try() {
  local do_lane=""; [ "${1:-}" = "lane" ] && { do_lane=1; shift; }
  local do_switch=""; [ "${1:-}" = "switch" ] && do_switch=1
  detect_worktree
  if [ -n "$do_lane" ]; then
    [ -n "$WT_REPO" ] || die "bench try lane must be run from inside an agent worktree — it's the lane's parent, so there's nothing to walk from the main checkout."
    detect_lane
    if [ "${#LANE_SRC[@]}" -eq 0 ]; then
      say "no holt children found for this lane — building $WT_REPO alone (same as plain 'bench try')."
    else
      local lane_list=""
      for name in "${!LANE_SRC[@]}"; do lane_list+="$name "; done
      say "lane: overriding $WT_REPO ($WT_PATH) plus ${#LANE_SRC[@]} holt child(ren): $lane_list"
    fi
  fi
  if [ -n "$WT_REPO" ]; then
    # Activating a worktree branch is fine and often exactly what you want —
    # it's the ONLY way to feel-test one unmerged branch on its own (try-batch
    # feels the whole open-PR queue combined, and needs a PR to exist at all;
    # neither can feel uncommitted work). What isn't fine is an AGENT doing it
    # unasked: activation is serial and machine-wide, so the fifth parallel
    # pane's switch silently replaces the fourth's. See agent_driving().
    # Checked before anything slow, so the refusal costs nothing.
    if [ -n "$do_switch" ] && agent_driving && [ -z "${BENCH_AGENT_SWITCH:-}" ]; then
      local switch_cmd="bench try switch"; [ -n "$do_lane" ] && switch_cmd="bench try lane switch"
      die "activation from a worktree is the human's call — hand it over: '$switch_cmd' from a pane in $WT_PATH. (Plain 'bench try${do_lane:+ lane}' is yours to run freely. If they already asked you to activate: BENCH_AGENT_SWITCH=1 $switch_cmd.)"
    fi
    say "you're in an agent worktree — overriding $WT_REPO with $WT_PATH"
  fi
  local host; host="$(host_name)"
  ensure_perch_dev_app   # if perch is the local source, build + inject its dev app
  say "building $host against the LOCAL checkouts (uncommitted edits included)…"
  # shellcheck disable=SC2046
  (cd "$CONSUMER" && nix build ".#darwinConfigurations.$host.system" $(overrides))
  say "build OK — nothing pushed, nothing activated."
  if [ -n "$do_switch" ]; then
    say "switching (this activates the LOCAL build on this machine)…"
    activate_built "$host"
    record_activation "$host"
    active_banner
    warn "when happy: commit, land the branch via its PR, then bench ship —"
    warn "so a plain rebuild reproduces what you're running."
  else
    say "to activate it too: bench try${do_lane:+ lane} switch"
  fi
}

# ── bench try-batch: feel-test the whole review queue in ONE rebuild ─────────
# Activating a machine is serial — one `darwin-rebuild switch` = one machine
# state — so you can only feel-test one feature at a time. The tempting shortcut
# (merge every ready PR to main, THEN rebuild and tick them off) puts unverified
# code on main before you've felt it, so a bug you find is already landed.
# try-batch inverts that: for each repo it builds a THROWAWAY integration tree
# (the main checkout's committed HEAD + every open PR merged in), overrides the
# flake at those trees, and builds/activates the combined result ONCE. main is
# never touched; you test the whole queue in a single rebuild, then merge only
# the PRs that passed and leave the rest open. It ends by printing the PRs as a
# tick-off checklist — each PR's own body carries its Verify steps (see the ship
# skill), so open the PR to know what to check. A PR that conflicts with the
# batch (or is a fork whose head isn't on origin) is dropped — with a warning AND
# a "dropped" footer under the checklist, never silently — so it can't quietly
# vanish from the summary; test that one on its own branch.
cleanup_batch() { # remove every integration worktree + the scratch dir (EXIT trap)
  local repo
  if [ "${#BATCH_SRC[@]}" -gt 0 ]; then
    for repo in "${!BATCH_SRC[@]}"; do
      git -C "$(repo_dir "$repo")" worktree remove --force "${BATCH_SRC[$repo]}" 2>/dev/null || true
    done
  fi
  [ -n "$BATCH_SCRATCH" ] && rm -rf "$BATCH_SCRATCH"
  return 0
}

cmd_try_batch() {
  local do_switch=""
  if [ "${1:-}" = "switch" ]; then do_switch=1; shift; fi
  command -v gh >/dev/null 2>&1 || die "bench try-batch needs the gh CLI to find your open PRs."

  # Which repos to sweep: any overridable repos named as args, else all of them.
  # perch is overridable too — its PRs build a signed dev app injected into the
  # flake (ensure_perch_dev_app), so it feel-tests like the rest.
  local -a want_repos=()
  if [ "$#" -gt 0 ]; then
    local a
    for a in "$@"; do
      if printf '%s\n' "${OVERRIDABLE[@]}" | grep -qx "$a"; then
        want_repos+=("$a")
      else
        warn "skipping '$a' — not a flake-overridable repo (batchable: ${OVERRIDABLE[*]})."
      fi
    done
    [ "${#want_repos[@]}" -gt 0 ] || die "nothing overridable to batch."
  else
    want_repos=("${OVERRIDABLE[@]}")
  fi

  local host; host="$(host_name)"
  # pwd -P to a REAL path: the integration trees become `path:` flake overrides,
  # and Nix's fetcher rejects a symlinked component — $TMPDIR is under /var
  # (→ /private/var) on macOS, so the raw mktemp path fails with "path is a
  # symlink". (Same gotcha the dev-app temp dir already dodges.)
  BATCH_SCRATCH="$(cd "$(mktemp -d "${TMPDIR:-/tmp}/bench-batch.XXXXXX")" && pwd -P)"
  trap cleanup_batch EXIT

  local -a checklist=() dropped=()
  local repo
  for repo in "${want_repos[@]}"; do
    local dir; dir="$(repo_dir "$repo")"
    [ -d "$dir/.git" ] || continue
    # Open PRs, as "num<TAB>head<TAB>title<TAB>url" lines. gh's own --jq keeps
    # us from shelling out to jq.
    local prs
    prs="$(gh pr list --repo "$(gh_repo "$repo")" --state open \
             --json number,headRefName,title,url \
             --jq '.[] | [.number, .headRefName, .title, .url] | @tsv' 2>/dev/null || true)"
    [ -n "$prs" ] || continue

    say "$repo: integrating $(printf '%s\n' "$prs" | grep -c '') open PR(s) onto main's HEAD…"
    git -C "$dir" fetch -q origin 2>/dev/null || true
    local wtdir="$BATCH_SCRATCH/$repo"
    git -C "$dir" worktree add -q --detach "$wtdir" HEAD

    local num head title url included=0
    while IFS=$'\t' read -r num head title url; do
      [ -n "$num" ] || continue
      if ! git -C "$wtdir" rev-parse -q --verify "origin/$head^{commit}" >/dev/null 2>&1; then
        warn "$repo: can't find origin/$head (fork PR?) — skipping #$num."
        dropped+=("$(printf '      %-10s #%-4s %s' "$repo" "$num" "$title")")
        dropped+=("$(printf '                  fork PR (head not on origin) — %s' "$url")")
        continue
      fi
      if git -C "$wtdir" merge --no-edit "origin/$head" >/dev/null 2>&1; then
        checklist+=("$(printf '  %s[ ]%s %s%-10s%s #%-4s %s' \
          "$C_WARN" "$C_OFF" "$C_REPO" "$repo" "$C_OFF" "$num" "$title")")
        checklist+=("$(printf '                  %s%s%s' "$C_MUT" "$url" "$C_OFF")")
        included=$((included + 1))
      else
        git -C "$wtdir" merge --abort 2>/dev/null || true
        warn "$repo: dropping #$num ($head) — it conflicts with the batch; test it on its own."
        dropped+=("$(printf '      %-10s #%-4s %s' "$repo" "$num" "$title")")
        dropped+=("$(printf '                  conflicts with the batch — %s' "$url")")
      fi
    done <<<"$prs"

    if [ "$included" -gt 0 ]; then
      BATCH_SRC["$repo"]="$wtdir"
    else
      git -C "$dir" worktree remove --force "$wtdir" 2>/dev/null || true
    fi
  done

  if [ "${#BATCH_SRC[@]}" -eq 0 ]; then
    if [ "${#dropped[@]}" -gt 0 ]; then
      warn "every open PR was dropped from the batch (conflicts/forks) — nothing to build:"
      printf '%s\n' "${dropped[@]}"
      warn "test each on its own branch (bench try from its worktree)."
    else
      say "no open PRs to batch — nothing to do (plain 'bench try' tests the pinned tree)."
    fi
    return 0
  fi

  ensure_perch_dev_app   # if perch's PRs were batched, build + inject its dev app
  say "building $host against ${#BATCH_SRC[@]} batched integration tree(s)…"
  # shellcheck disable=SC2046
  (cd "$CONSUMER" && nix build ".#darwinConfigurations.$host.system" $(overrides))
  say "build OK — nothing pushed, nothing merged, main untouched."

  if [ -n "$do_switch" ]; then
    say "switching (activates the COMBINED unmerged batch on this machine)…"
    activate_built "$host"
    record_activation "$host"   # the integration trees ARE the receipt's sources
    warn "you are now running a COMBINATION of unmerged branches — none of it is on main."
    hint "bench status will keep saying so · bench rebuild returns to the pinned build"
  fi

  echo
  say "test checklist — verify each PR (steps are in its body), then merge only the winners:"
  printf '%s\n' "${checklist[@]}"
  if [ "${#dropped[@]}" -gt 0 ]; then
    echo
    warn "dropped from the batch — NOT built above; test each on its own branch:"
    printf '%s\n' "${dropped[@]}"
  fi
  echo
  warn "none of these are merged. gh pr merge the ones that pass; leave the rest open."
}

cmd_ship() {
  # Walk the chain upstream→downstream. For each repo: refuse dirty trees
  # (your commits are yours to write), bump any stale family locks, push.
  for name in "${FAMILY[@]}" consumer; do
    local dir; dir="$(repo_dir "$name")"
    [ -d "$dir/.git" ] || continue
    if [ -n "$(git -C "$dir" status --porcelain)" ]; then
      git -C "$dir" status --short
      die "$name has uncommitted changes — commit (or stash) them first, then re-run bench ship."
    fi
  done

  # Fast-forward every checkout to origin BEFORE reading a single HEAD. The lock
  # bump below is computed from `head_rev`, and right after `gh pr merge` each
  # main checkout is behind origin by exactly the squash commit — so a ship that
  # skips this pins the PRE-merge rev, prints "shipped", and `bench status` then
  # calls the edge ✓ current, because it compares the lock against that same
  # stale local HEAD. Nothing in the output distinguishes it from a real ripple.
  # This has bitten every /ship that merged a PR in a repo the chain touches.
  for name in "${FAMILY[@]}" consumer; do
    local dir; dir="$(repo_dir "$name")"
    [ -d "$dir/.git" ] || continue
    git -C "$dir" rev-parse '@{u}' >/dev/null 2>&1 || continue
    # A fetch that fails (offline) is a warning, not a death — shipping from the
    # local state still works, and the per-edge verify below is the real guard.
    git -C "$dir" fetch --quiet 2>/dev/null || { warn "$name: fetch failed — reading the local checkout as-is"; continue; }
    local behind; behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}')"
    [ "$behind" != "0" ] || continue
    if git -C "$dir" merge --ff-only '@{u}' >/dev/null 2>&1; then
      say "$name: fast-forwarded $behind commit(s) from origin"
    else
      die "$name is $behind commit(s) behind origin and won't fast-forward (diverged) — resolve it by hand, then re-run bench ship."
    fi
  done

  # Agent branches never block a ship (main is main), but don't let them rot silently.
  for name in "${FAMILY[@]}"; do
    # Guarded like every other loop here: an absent child repo (a workshop clone
    # that hasn't run `bench clone` yet) makes the `git -C` inside exit 128 under
    # `set -e`, killing the ship with no output at all.
    [ -d "$(repo_dir "$name")/.git" ] || continue
    local unmerged; unmerged="$(unmerged_agent_branches "$name" | tr '\n' ' ')"
    if [ -n "${unmerged// /}" ]; then
      warn "$name has unmerged agent branches (not shipping them — open a PR to land): $unmerged"
    fi
  done

  local stale=()
  for name in "${FAMILY[@]}" consumer; do
    local dir; dir="$(repo_dir "$name")"
    [ -d "$dir/.git" ] || continue

    # Bump this repo's locks for any upstream family input that moved.
    local bumped=()
    for edge in "${EDGES[@]}"; do
      read -r holder input source <<<"$edge"
      [ "$holder" = "$name" ] || continue
      local want; want="$(head_rev "$source")"
      [ "$(locked_rev "$holder" "$input")" != "$want" ] || continue
      say "$name: updating lock for ${input}…"
      (cd "$dir" && nix flake update "$input")
      # `nix flake update` can resolve the input from the flake cache, see "no
      # change", and leave the lock on the old rev — exiting 0 the whole way.
      # Never take its word for it: read the lock back, and only then treat the
      # hop as bumped. (--refresh bypasses that cache; it usually works and has
      # once not, hence the second read rather than a second assumption.)
      if [ "$(locked_rev "$holder" "$input")" != "$want" ]; then
        warn "$name: lock for $input didn't move — retrying with --refresh"
        (cd "$dir" && nix flake update "$input" --refresh)
      fi
      if [ "$(locked_rev "$holder" "$input")" = "$want" ]; then
        bumped+=("$input")
      else
        stale+=("${name}→${input}")
        warn "$name: lock for $input still pins $(locked_rev "$holder" "$input" | cut -c1-7), not ${want:0:7} — leaving it rather than committing a lie"
      fi
    done
    # Guard the commit on the lock having actually changed: a `bumped` list plus
    # an unchanged tree makes `git commit` exit 1, and under `set -e` that kills
    # every remaining hop of the chain — the ripple aborts halfway and the run
    # never even reaches its "shipped" line.
    if [ "${#bumped[@]}" -gt 0 ] && [ -n "$(git -C "$dir" status --porcelain -- flake.lock)" ]; then
      (cd "$dir" && git add flake.lock && git commit -m "Update flake inputs (${bumped[*]})")
    fi

    # Push if there's anywhere to push to and anything to push.
    if git -C "$dir" rev-parse '@{u}' >/dev/null 2>&1; then
      local ahead; ahead="$(git -C "$dir" rev-list --count '@{u}..HEAD')"
      if [ "$ahead" != "0" ]; then
        say "$name: pushing $ahead commit(s)…"
        git -C "$dir" push
      fi
    fi
  done

  if [ "${#stale[@]}" -gt 0 ]; then
    die "shipped what it could, but these edges are STILL stale: ${stale[*]} — bump each by hand (cd <repo> && nix flake update <input>) and re-run, or downstream builds the old code."
  fi
  say "shipped. Apply it to this machine with: bench rebuild"
}

# ── Claude Code agent worktrees ─────────────────────────────────────────────
# The worktree lifecycle — create on `claude --worktree`, save-on-close, and
# list/resume — used to live here, but it isn't family business: it's a standalone,
# repo-agnostic product now, `holt` (its own repo, ejected from the incubator
# 2026-08-03), which the RICE takes as a flake input and ships on PATH, wired into
# Claude Code's WorktreeCreate/WorktreeRemove hooks — because the rice already
# ships the agent keybinds. bench no longer owns it — not every machine that runs
# `holt` has bench. To see or resume parked/live agent worktrees across ALL repos,
# run `holt` (or `holt <name>`); its predecessor `wt` is frozen but still reads the
# same registry.tsv. bench still *reports* family worktrees in `bench status` — and
# reads that registry to tell a real parked session from a branch that outlived its
# PR — but it doesn't drive their lifecycle.

cmd_rebuild() {
  local host; host="$(host_name)"
  local was_local=""; [ -f "$ACTIVE_FILE" ] && was_local=1
  say "pinned rebuild of $host from ${CONSUMER}…"
  (cd "$CONSUMER" && heal nix build ".#darwinConfigurations.$host.system")
  activate_built "$host"
  # No overrides above → what's running is exactly what the locks pin. Tearing
  # up the receipt IS how you get back to a trustworthy `bench status`.
  clear_activation
  [ -n "$was_local" ] && say "back on the pinned build — the local-code warning is cleared."
  say "the house stands."
}

cmd_pull() {
  # workshop first (bench itself lives here — a stale clone is how a merged PR
  # ambushes the next push). org-profile + homebrew-tap are CI-owned but still
  # want a fresh local checkout: `bench status` diffs them, and a stale
  # homebrew-tap clone hides cask/formula bumps CI already pushed (the
  # "released but not installed" trap). Superset of cmd_ship's repo set.
  # trill + hausfold.co ride along too: bench plants both checkouts (cmd_clone)
  # and the docs sweep reads both (DOCS_REPOS), so a stale local copy makes the
  # sweep reconcile yesterday's tree — and hausfold.co is the one repo here whose
  # deploys happen on push, so stale there is a live-site footgun. Both stay out
  # of FAMILY — neither is a flake input.
  #
  # It is spelled `hausfold.co`, and it must stay spelled in full. Between
  # §3.3's step 4 and §10 the layer's checkout was `$ROOT/hausfold`, one dot
  # away from this one, so shortening the site to `hausfold` would have put the
  # SAME name in this array twice and had `bench pull` fast-forward one checkout
  # under the other's identity. §10 moved the layer to `$ROOT/haus` and the two
  # names no longer share a prefix — which removes the trap, not the rule.
  local -a repos=(workshop "${FAMILY[@]}" org-profile homebrew-tap trill hausfold.co consumer)
  # `bench pull <repo>…` narrows to the named repos (what `bench status`'s
  # ↓-behind hint points you at); bare `bench pull` fast-forwards them all.
  if [ "$#" -gt 0 ]; then
    local a; local -a want=()
    for a in "$@"; do
      if printf '%s\n' "${repos[@]}" | grep -qx "$a"; then
        want+=("$a")
      else
        warn "unknown repo '$a' — pullable: ${repos[*]}"
      fi
    done
    [ "${#want[@]}" -gt 0 ] || die "nothing to pull."
    repos=("${want[@]}")
  fi
  local name
  for name in "${repos[@]}"; do
    local dir; dir="$(repo_dir "$name")"
    [ -d "$dir/.git" ] || continue
    say "pulling ${name}…"
    git -C "$dir" pull --ff-only || warn "$name: couldn't fast-forward; resolve by hand"
  done
}

version_file() { # version_file <repo> — WHERE a releasable repo's version lives
  case "$1" in
    pounce)    echo "$(repo_dir "$1")/pkgs/pounce/default.nix" ;;
    perch)     echo "$(repo_dir "$1")/VERSION" ;;
    haus)      echo "$(repo_dir "$1")/VERSION" ;;
    holt)      echo "$(repo_dir "$1")/VERSION" ;;
    *) return 1 ;;
  esac
}

read_version() { # read_version <repo> — the version string that repo tags at
  local f; f="$(version_file "$1")" || return 1
  case "$1" in
    pounce)    sed -n 's/^ *version = "\([^"]*\)";.*/\1/p' "$f" | head -1 ;;
    perch)     tr -d '[:space:]' < "$f" 2>/dev/null ;;
    haus)      tr -d '[:space:]' < "$f" 2>/dev/null ;;
    holt)      tr -d '[:space:]' < "$f" 2>/dev/null ;;
  esac
}

write_version() { # write_version <repo> <version> — stamp the version source in place
  local f; f="$(version_file "$1")" || return 1
  case "$1" in
    # Only the declaration line matches ^ *version = "…"; the POUNCE_VERSION="$version"
    # line below it starts with POUNCE_, so it's left untouched. Written via a temp
    # file rather than `sed -i` — GNU (Linux/CI) and BSD (macOS) disagree on the
    # -i suffix arg, so the portable path is redirect + mv.
    pounce)    local t; t="$(mktemp)"; sed -E "s/^( *version = \")[^\"]*(\";.*)/\1$2\2/" "$f" >"$t" && mv "$t" "$f" ;;
    perch)     printf '%s\n' "$2" > "$f" ;;
    haus)      printf '%s\n' "$2" > "$f" ;;
    # holt's version lives in FOUR files, not one — VERSION plus three SDK
    # manifests (npm/PyPI/crates each declare their own). bench doesn't learn
    # their shapes; the repo owns that, so the knowledge sits next to the
    # manifests it has to track. Its --check form is what release.yml runs
    # against the pushed tag.
    holt)      local s; s="$(repo_dir "$1")/script/stamp-version.sh"
               [ -x "$s" ] || die "holt has no script/stamp-version.sh — bench pull holt"
               "$s" "$2" >/dev/null ;;
  esac
}

# CalVer or semver? Every repo here is CalVer — the date IS the version, so
# there is no number to argue about — EXCEPT holt, and the exception is forced
# rather than chosen. holt publishes libraries to npm, PyPI and crates.io, all
# three of which already hold hausfold-holt 0.1.0 and none of which let a
# version be taken back; and its Go SDK would need its import path to end in
# `/v2026` under CalVer, changing every January. So holt takes an explicit
# semver argument and the others refuse one.
version_scheme() { # version_scheme <repo> — calver | semver
  case "$1" in
    holt) echo semver ;;
    *)    echo calver ;;
  esac
}

# Date-based versions (CalVer). A release is stamped with the day it's cut —
# YYYY.MM.DD — never a hand-typed semver. A second release on the same day gets
# a -N disambiguator (…-1, …-2); git version-sort and Homebrew both order that
# AFTER the bare date, so `latest_tag` and "vs main" stay right.
today_version() { date +%Y.%m.%d; }

next_version() { # next_version <repo> — today's date, with -N if today's already tagged
  local dir base n; dir="$(repo_dir "$1")"; base="$(today_version)"
  git -C "$dir" fetch -q --tags 2>/dev/null || true
  if ! git -C "$dir" rev-parse -q --verify "refs/tags/v$base" >/dev/null; then
    echo "$base"; return
  fi
  n=1
  while git -C "$dir" rev-parse -q --verify "refs/tags/v$base-$n" >/dev/null; do
    n=$((n + 1))
  done
  echo "$base-$n"
}

# ── Watching the release run ──────────────────────────────────────────────────
# `bench release` BLOCKS on CI rather than handing you a URL, and that's a
# correctness fix as much as a nicety: perch's release workflow pushes a
# `bump-flake` commit BACK to the repo (the notarized ZIP's sha256), so
# the instant the tag lands your checkout is behind origin. Returning early
# hands you a shell where `bench ship` would ripple a rev CI is about to
# supersede. Blocking, then fast-forwarding, closes that window.
#
# There is exactly ONE workflow to watch — each repo's `release`, holding 1–3
# jobs (haus: publish; pounce: publish + bump-tap; perch: those plus
# bump-flake). The tap bump is a plain push into homebrew-tap, which has no
# workflows of its own, so when this run goes green the release IS live —
# nothing further to chase.

SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
WATCH_FRAME_S=0.1         # one spinner frame — 10 fps, so a 10-glyph cycle = 1s
WATCH_POLL_S=5            # seconds between `gh run view` calls (see below)

# Frame rate and poll rate are DELIBERATELY unrelated. The naive loop couples
# them — fetch, paint, sleep — and that costs you twice: the spinner freezes for
# however long the API call takes, always at the same point in the cycle (so it
# reads as a stutter, not as latency), and the durations can only advance in
# poll-sized jumps. Here the fetch runs in the BACKGROUND while the paint loop
# keeps ticking at 10 fps, and running jobs are clocked locally from their start
# time — so the display is smooth and second-accurate at any poll interval, and
# the interval is free to be a polite 5s instead of a hammering 1s.
declare -ga WATCH_ROWS=()
WATCH_RUN_STATUS=""; WATCH_RUN_CONCL=""; WATCH_PAINTED=0
WATCH_FETCH_PID=""; WATCH_SNAP_FILE=""

# Turn a `gh run view --json status,conclusion,jobs` blob into one
# state<TAB>name<TAB>detail<TAB>since row per job, plus a trailing RUN row.
# Durations need ISO-8601 arithmetic, which bash can't do portably (BSD vs GNU
# `date -d`), so this lives in python like the other JSON readers here. A job
# that hasn't started carries a year-1 timestamp — hence the `< 2000` guard,
# without which "queued" would render as a two-millennium runtime.
#
# `since` is the start time as a unix epoch, and it is set ONLY for a job still
# running. That's the handoff to the paint loop: a finished job's duration is
# final and comes from here, but a running one's is re-derived every frame from
# `since`, so the clock ticks once a second no matter how stale this snapshot is.
WATCH_RENDER_PY='
import json, sys
from datetime import datetime, timezone

def parse(t):
    try:    return datetime.fromisoformat((t or "").replace("Z", "+00:00"))
    except ValueError: return None

d = json.load(sys.stdin)
now = datetime.now(timezone.utc)
for j in d.get("jobs", []):
    st, cc = j.get("status"), j.get("conclusion")
    if st != "completed":
        state = "run" if st == "in_progress" else "wait"
    else:
        state = {"success": "ok", "skipped": "skip", "cancelled": "skip"}.get(cc, "fail")
    started, ended = parse(j.get("startedAt")), parse(j.get("completedAt"))
    since = ""
    if state == "wait" or not started or started.year < 2000:
        detail = {"wait": "queued", "skip": "skipped"}.get(state, "—")
    else:
        end = ended if (ended and ended.year >= 2000 and st == "completed") else now
        secs = max(0, int((end - started).total_seconds()))
        detail = "%dm %02ds" % (secs // 60, secs % 60) if secs >= 60 else "%ds" % secs
        if st != "completed":
            since = "%d" % started.timestamp()
    # Clamp the name: the live repaint counts LINES to move the cursor back up,
    # so a row that soft-wraps in a narrow terminal would desync the whole frame.
    print("%s\t%s\t%s\t%s" % (state, (j.get("name") or "?")[:34], detail, since))
print("RUN\t%s\t%s" % (d.get("status") or "", d.get("conclusion") or ""))
'

row_glyph() { # row_glyph <state> <frame> — the status mark at the head of a job row
  case "$1" in
    run)  printf '%s%s%s' "$C_FOG" "${SPIN[$(( $2 % ${#SPIN[@]} ))]}" "$C_OFF" ;;
    ok)   printf '%s✓%s' "$C_OK"  "$C_OFF" ;;
    fail) printf '%s✗%s' "$C_ERR" "$C_OFF" ;;
    skip) printf '%s–%s' "$C_MUT" "$C_OFF" ;;
    *)    printf '%s·%s' "$C_MUT" "$C_OFF" ;;
  esac
}

# Repaint every row in place. Colour lives OUTSIDE the %-*s width (an escape
# counted as width shears the column), same discipline as cmd_status.
#
# Everything in here is a builtin on purpose: this runs 10× a second, and a
# `$(date)` or `$(dur …)` per row per frame would be a few hundred forks a
# minute just to draw a clock.
paint_live() { # paint_live <frame>
  local row state name detail since now secs
  now="${EPOCHSECONDS:-$(date +%s)}"        # bash ≥5 has it free; older forks once
  [ "$WATCH_PAINTED" -gt 0 ] && printf '\033[%dA' "$WATCH_PAINTED"
  WATCH_PAINTED=0
  for row in "${WATCH_ROWS[@]}"; do
    IFS=$'\t' read -r state name detail since <<<"$row"
    # A running job's clock is OURS, not the snapshot's — otherwise the seconds
    # would sit still between polls and then jump by the poll interval. The cost
    # is that a job finishing just after a poll keeps counting until the next
    # one, so the number can tick DOWN by a few seconds as the row flips to ✓.
    # That's the honest direction to be wrong in: "running for N seconds now" and
    # "took N seconds" are different facts, and CI's is the one that's final.
    if [ -n "$since" ]; then
      secs=$(( now - since )); [ "$secs" -lt 0 ] && secs=0   # clock skew vs GitHub
      if [ "$secs" -ge 60 ]
        then printf -v detail '%dm %02ds' $((secs / 60)) $((secs % 60))
        else printf -v detail '%ds' "$secs"; fi
    fi
    printf '\033[2K   %s  %s%-34s%s %s%s%s\n' \
      "$(row_glyph "$state" "$1")" "$C_REPO" "$name" "$C_OFF" "$C_MUT" "$detail" "$C_OFF"
    WATCH_PAINTED=$((WATCH_PAINTED + 1))
  done
}

# ── the background poll ───────────────────────────────────────────────────────
# `gh run view` takes anywhere from 200ms to well over a second, and blocking the
# paint loop on it is what made the spinner stutter. So it runs detached, writing
# into a scratch file the loop picks up whenever it happens to be ready.

watch_fetch_start() { # watch_fetch_start <repo> <run-id>
  # Write-then-rename so the loop can never read a half-written blob, and so a
  # FAILED fetch (no rename) simply leaves the last good snapshot in place —
  # a blip in the network shouldn't blank the rows.
  gh run view "$2" --repo "$(gh_repo "$1")" --json status,conclusion,jobs \
     >"$WATCH_SNAP_FILE.part" 2>/dev/null && mv -f "$WATCH_SNAP_FILE.part" "$WATCH_SNAP_FILE" &
  WATCH_FETCH_PID=$!
}

watch_absorb() { # re-read the newest snapshot into WATCH_ROWS / WATCH_RUN_*
  local row _
  [ -s "$WATCH_SNAP_FILE" ] || return 0
  WATCH_ROWS=(); WATCH_RUN_STATUS=""; WATCH_RUN_CONCL=""
  while IFS= read -r row; do
    case "$row" in
      RUN$'\t'*) IFS=$'\t' read -r _ WATCH_RUN_STATUS WATCH_RUN_CONCL <<<"$row" ;;
      *)         WATCH_ROWS+=("$row") ;;
    esac
  done < <(python3 -c "$WATCH_RENDER_PY" <"$WATCH_SNAP_FILE" 2>/dev/null || true)
}

watch_cleanup() {
  [ -n "$WATCH_FETCH_PID" ] && kill "$WATCH_FETCH_PID" 2>/dev/null
  [ -n "$WATCH_SNAP_FILE" ] && rm -f "$WATCH_SNAP_FILE" "$WATCH_SNAP_FILE.part"
  WATCH_FETCH_PID=""; WATCH_SNAP_FILE=""
  return 0                                  # never let the last test trip set -e
}

release_run_id() { # release_run_id <repo> <tag> — the run for that tag, waiting for it to appear
  # A tag push takes a few seconds to materialise as a run, and gh keys tag runs
  # by --branch (head_branch is the tag name for a tag push).
  local repo="$1" tag="$2" id _
  for _ in $(seq 1 20); do
    id="$(gh run list --repo "$(gh_repo "$repo")" --workflow release --branch "$tag" \
            --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)"
    [ -n "$id" ] && [ "$id" != "null" ] && { echo "$id"; return 0; }
    sleep 2
  done
  return 1
}

watch_release_run() { # watch_release_run <repo> <run-id> — block till it ends; 0 iff green
  local repo="$1" id="$2" frame=0 row state name detail now polled=0
  # Live redraw only on a TTY — piped, in CI, or under bats we print one plain
  # line per state CHANGE, so a log stays readable and no cursor escape ever
  # reaches a file. (Motion, unlike colour, isn't gated on NO_COLOR: a spinner
  # on a no-colour terminal is still the thing you want to see.)
  local live=""; [ -t 1 ] && live=1
  declare -A seen=()

  WATCH_SNAP_FILE="$(mktemp "${TMPDIR:-/tmp}/bench-watch.XXXXXX")"
  if [ -n "$live" ]; then
    printf '\033[?25l'                                   # hide the cursor while we repaint
    # Restore it however we leave, including Ctrl-C — a terminal left with no
    # cursor is the worst thing a spinner can do to you. EXIT (not RETURN):
    # under `set -e` a losing run terminates the shell outright rather than
    # returning, and a RETURN trap never fires on that path.
    trap 'printf "\033[?25h"; watch_cleanup' EXIT
    trap 'printf "\033[?25h\n"; watch_cleanup; warn "still running on CI — bench release does not cancel it."; exit 130' INT
  else
    trap 'watch_cleanup' EXIT
  fi

  while :; do
    now="${EPOCHSECONDS:-$(date +%s)}"
    # Kick off the next poll when one is due and none is in flight…
    if [ -z "$WATCH_FETCH_PID" ] && { [ "$polled" -eq 0 ] || [ $((now - polled)) -ge "$WATCH_POLL_S" ]; }; then
      polled="$now"; watch_fetch_start "$repo" "$id"
    fi
    # …and pick it up whenever it lands. Live, that check is non-blocking, which
    # is the whole point: the spinner keeps ticking through the call. Logging,
    # there's no animation to protect, so just block on it and stay simple.
    if [ -n "$WATCH_FETCH_PID" ] && { [ -z "$live" ] || ! kill -0 "$WATCH_FETCH_PID" 2>/dev/null; }; then
      wait "$WATCH_FETCH_PID" 2>/dev/null || true      # reap; a failed fetch is fine
      WATCH_FETCH_PID=""
      watch_absorb
    fi

    if [ -n "$live" ]; then
      paint_live "$frame"
    else
      for row in "${WATCH_ROWS[@]}"; do
        IFS=$'\t' read -r state name detail _ <<<"$row"
        [ "${seen[$name]:-}" = "$state" ] && continue
        seen[$name]="$state"
        printf '   %s  %s (%s)\n' "$(row_glyph "$state" 0)" "$name" "$detail"
      done
    fi

    [ "$WATCH_RUN_STATUS" = "completed" ] && break

    if [ -n "$live" ]; then
      frame=$((frame + 1)); sleep "$WATCH_FRAME_S"
    else
      sleep "$WATCH_POLL_S"                 # no animation to keep alive, so just wait
    fi
  done

  if [ -n "$live" ]; then printf '\033[?25h'; fi
  trap - EXIT INT
  watch_cleanup
  [ "$WATCH_RUN_CONCL" = "success" ]
}

cmd_release() {
  # Cut a release: stamp today's date as the version, commit it into the repo's
  # own version source (so the tag can't drift from what the code says — CI
  # double-checks anyway), push, then tag v<version>. The tag push is the
  # button; CI does the rest: GitHub release + source tarball + a version bump
  # in homebrew-tap (which is CI-owned — never hand-bump it). No number is ever
  # typed by hand — the date IS the version. Division of labor: feature commits
  # are yours, lock bumps are ship's, the date-stamp + tag are release's,
  # formula bumps are CI's.
  #
  # Then it BLOCKS on that CI run (see the watch section above) instead of
  # leaving you with a URL and a checkout that's about to fall behind.
  #
  # holt is the one repo that takes a version ARGUMENT rather than a date — see
  # version_scheme() for why it has to. There the number is a judgement about
  # the diff since the last tag (does this break a published SDK's API?), which
  # is the one thing the date can't encode; ask an agent for the bump if you
  # don't want to make the call yourself.
  local name="" ship="" askver=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ship) ship=1 ;;
      -*)     die "unknown flag: $1   (usage: bench release <repo> [version] [--ship])" ;;
      *)      if [ -z "$name" ]; then name="$1"; else askver="$1"; fi ;;
    esac
    shift
  done
  local usage="usage: bench release <repo> [version] [--ship]   (releasable: pounce, perch, haus, holt)"
  [ -n "$name" ] || die "$usage"

  local dir; dir="$(repo_dir "$name")"
  [ -d "$dir/.git" ] || die "$name is not cloned here — bench clone"
  version_file "$name" >/dev/null \
    || die "bench release doesn't know '$name' yet (releasable: pounce, perch, haus, holt)"

  local scheme lasttag; scheme="$(version_scheme "$name")"; lasttag="$(latest_tag "$name")"
  if [ "$scheme" = semver ]; then
    [ -n "$askver" ] || die "$name is semver — give it a number: bench release $name <X.Y.Z>
  (last released: ${lasttag:-none} · tree says $(read_version "$name"))"
    [[ "$askver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
      || die "'$askver' is not a plain X.Y.Z semver"
  else
    [ -z "$askver" ] || die "$name is CalVer — the date IS the version, drop the '$askver'"
  fi

  [ -z "$(git -C "$dir" status --porcelain)" ] \
    || die "$name is dirty — commit (and bench ship) first"
  git -C "$dir" fetch -q --tags 2>/dev/null || true
  local ahead; ahead="$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo '?')"
  [ "$ahead" = "0" ] || die "$name has unpushed commits — bench ship first, then release"

  local version tag
  if [ "$scheme" = semver ]; then
    version="$askver"
    git -C "$dir" rev-parse -q --verify "refs/tags/v$version" >/dev/null \
      && die "v$version is already tagged on $name — pick the next number
  (npm/PyPI/crates versions are immutable; a cut one can only be superseded)"
  else
    # Today's date (YYYY.MM.DD, or …-N on a same-day repeat).
    version="$(next_version "$name")"
  fi
  tag="v$version"

  # Stamp it into the repo's own version source and commit, so HEAD already says
  # what the tag will claim. The whole-tree diff (rather than one file) is what
  # lets holt's stamp touch four manifests at once; it's safe because the clean-
  # tree check above means anything modified here was modified by write_version.
  write_version "$name" "$version"
  if ! git -C "$dir" diff --quiet; then
    say "$name: stamping version ${version}…"
    git -C "$dir" add -u
    git -C "$dir" commit -m "$name $version"
    git -C "$dir" rev-parse '@{u}' >/dev/null 2>&1 && git -C "$dir" push
  fi

  say "releasing $name $tag — pushing the tag; CI takes it from here…"
  git -C "$dir" tag -a "$tag" -m "$name $version"
  git -C "$dir" push origin "$tag"

  local runid=""
  if command -v gh >/dev/null 2>&1; then
    runid="$(release_run_id "$name" "$tag" || true)"
  fi
  if [ -z "$runid" ]; then
    # No gh, not authed, or the run never showed. The tag is pushed and CI is
    # running regardless — degrade to the old behaviour rather than failing.
    warn "can't watch the run from here — the tag is pushed and CI is running."
    hint "https://github.com/$(gh_repo "$name")/actions  (release → publish jobs)"
    warn "the version stamp moved $name's HEAD — run bench ship to ripple its lock downstream."
    return 0
  fi

  printf '\n%s   %s %s%s\n\n' "$C_MUT" "$name" "$tag" "$C_OFF"
  if ! watch_release_run "$name" "$runid"; then
    printf '\n'
    die "release run failed — gh run view $runid --repo $(gh_repo "$name") --log-failed"
  fi
  printf '\n'

  # perch has CI commit nix/release.nix back to the repo, so origin moved while
  # we watched. Fast-forward before anything reads this HEAD.
  git -C "$dir" pull -q --ff-only 2>/dev/null || true

  say "$name $version is live — https://github.com/$(gh_repo "$name")/releases/tag/$tag"
  if [ -n "$ship" ]; then
    printf '\n'
    cmd_ship
  else
    warn "the version stamp moved $name's HEAD — its lock edge downstream is now stale."
    hint "ripple it: bench ship   (or cut the next one with: bench release $name${askver:+ <version>} --ship)"
  fi
}

# ── docs-since ────────────────────────────────────────────────────────────────
# What has changed since the docs were last reconciled? Every repo carries a
# watermark in .docs-sync.json; this prints the commits past it, so the daily
# docs sweep never re-reads what it already read and never misses a day it slept
# through.
#
# The state file is COMMITTED, not gitignored: the sweep runs as a claude.ai
# routine in a throwaway Linux container, so anything it needs to remember
# between runs has to live in the repo. That also makes the watermark a visible
# record of how far the docs have been reconciled.
DOCS_STATE="$ROOT/.docs-sync.json"

# Every repo whose commits can invalidate a doc — the flake family, plus the
# workshop itself (bench/README/web live here), the two CI-owned leaves, and the
# two repos that carry docs without carrying a lock edge.
#
# 🚨 This list is NOT `FAMILY` plus trimmings, and must not be rewritten as one.
# `trill` and `hausfold.co` are deliberately outside `FAMILY` (no flake input, so
# try/try-batch/ship must never walk them) — but both have a README, in-repo docs
# and a live audience, so a sweep that skips them reports their docs clean for
# as long as the omission lasts — silently, because a repo with no arm looks
# exactly like a repo with nothing to say. trill was in that state from its
# eject (2026-08-09) until this line. Docs coverage and lock coverage are
# different questions; keep them different lists.
DOCS_REPOS=(workshop "${FAMILY[@]}" org-profile homebrew-tap trill hausfold.co)

docs_watermark() { # docs_watermark <repo> — last reconciled rev, "" if never
  [ -f "$DOCS_STATE" ] || { echo ""; return; }
  python3 - "$DOCS_STATE" "$1" <<'EOF'
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("repos", {}).get(sys.argv[2], {}).get("rev", ""))
except Exception:
    print("")
EOF
}

cmd_docs_since() {
  local mark="" any=0
  [ "${1:-}" = "--mark" ] && mark=1

  for name in "${DOCS_REPOS[@]}"; do
    local dir
    if [ "$name" = workshop ]; then dir="$ROOT"; else dir="$(repo_dir "$name")"; fi
    # A missing checkout is a HOLE in the sweep, not a repo with nothing to say —
    # and it looks identical to "clean" in the output, which is how a blind spot
    # survives for weeks. Say so out loud; `bench clone` plants every one of these.
    if [ ! -d "$dir/.git" ]; then
      warn "$name: no checkout at $dir — NOT swept (run: bench clone)"
      continue
    fi
    local head; head="$(git -C "$dir" rev-parse HEAD)"
    local base; base="$(docs_watermark "$name")"

    # Two different "no watermark"s, and they want opposite answers:
    #
    #   no entry at all — the repo just joined DOCS_REPOS, so NOTHING of it has
    #     ever been reconciled. Read the whole history: a one-day window here
    #     silently drops the backlog that adding the repo was meant to reach,
    #     and the next --mark then pins the watermark past it forever.
    #
    #   an entry whose rev is gone (rebased/force-pushed away) — the repo HAS
    #     been swept, we just can't say from where. Replaying it from birth
    #     would bury a real day's work, so fall back to a day and say the range
    #     is a guess.
    if [ -z "$base" ]; then
      warn "$name: first sweep — no watermark, reading its FULL history ($(git -C "$dir" rev-list --count HEAD) commits)"
    elif ! git -C "$dir" cat-file -e "$base^{commit}" 2>/dev/null; then
      warn "$name: watermark ${base:0:7} is gone (rebased away?) — reading the last day only"
      base="$(git -C "$dir" rev-list -1 --before='1 day ago' HEAD 2>/dev/null || echo "")"
    fi
    [ "$base" = "$head" ] && continue

    local range; range="$([ -n "$base" ] && echo "$base..HEAD" || echo HEAD)"
    # Skip the sweep's OWN commits. Doc PRs land on main like anything else, so
    # without this the routine reads yesterday's output as today's input — every
    # day, forever. The skill stamps each of its commits with a Docs-Sync
    # trailer precisely so they can be filtered back out here.
    local skip_own=(--invert-grep --grep='^Docs-Sync: ')
    # The C_* vars are empty when colour is off, so the format degrades to the
    # old plain '  %h %ad %s' — no escapes leak into a piped/redirected sweep.
    local log; log="$(git -C "$dir" log --no-merges "${skip_own[@]}" \
      --format="  ${C_MUT}%h %ad${C_OFF} %s" --date=short "$range" 2>/dev/null)"
    [ -n "$log" ] || continue

    any=1
    say "$name  ($(printf '%s\n' "$log" | grep -c .) commits)"
    printf '%s\n' "$log"
    printf '  %sfiles:%s %s\n\n' "$C_MUT" "$C_OFF" \
      "$(git -C "$dir" diff --name-only "$range" 2>/dev/null | head -40 | tr '\n' ' ')"
  done

  [ "$any" = 1 ] || say "nothing new since the last docs sweep."

  if [ -n "$mark" ]; then
    # Pairs, not names: repo_dir is the one place that knows a checkout's
    # directory (it differs from the name for `workshop`, and carried §10's
    # migration fallback for `haus`), so resolve here rather than rebuilding
    # "$root/$name" in python and silently missing the repo.
    local -a docs_pairs=()
    for name in "${DOCS_REPOS[@]}"; do docs_pairs+=("$name=$(repo_dir "$name")"); done
    python3 - "$DOCS_STATE" "${docs_pairs[@]}" <<'EOF'
import json, subprocess, sys, datetime
state_path, *pairs = sys.argv[1:]
repos = [p.split("=", 1) for p in pairs]
state = {"repos": {}}
try:
    state = json.load(open(state_path))
    state.setdefault("repos", {})
except Exception:
    pass
for name, d in repos:
    # Mark `main`, never HEAD. A sweep ends sitting on its own docs-sync-* PR
    # branch, and recording that tip would park the watermark on a commit main
    # doesn't contain — every later run then re-reads from a bogus base. main is
    # also the right ANSWER: the watermark tracks the source commits we've read,
    # and those land on main; the doc PR is this sweep's output, not its input.
    try:
        rev = subprocess.check_output(["git", "-C", d, "rev-parse", "main"], text=True).strip()
    except Exception:
        try:
            rev = subprocess.check_output(["git", "-C", d, "rev-parse", "HEAD"], text=True).strip()
        except Exception:
            continue
    state["repos"][name] = {"rev": rev}
state["last_run"] = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
json.dump(state, open(state_path, "w"), indent=2)
open(state_path, "a").write("\n")
EOF
    say "watermarks recorded — next sweep starts from here."
  fi
}

cmd_clone() {
  # Directory name from the loop, remote from gh_repo — they still differ for
  # org-profile (./org-profile ← hausfold/.github), and gh_repo is the only
  # place that knows. The layer needs no arm of its own: since §10 its checkout
  # is ./haus and its repo is `hausfold/haus`, so it falls through gh_repo's
  # default like everyone else.
  for name in "${FAMILY[@]}" org-profile homebrew-tap; do
    local dir; dir="$(repo_dir "$name")"
    if [ -d "$dir/.git" ]; then
      say "$name already here"
    else
      say "cloning ${name}…"
      git clone "https://github.com/$(gh_repo "$name").git" "$dir"
    fi
  done

  # trill and hausfold.co are the odd ones out: same org as everything above, but
  # neither is a flake input, so try/try-batch/ship must never walk them and they
  # stay out of FAMILY. The workshop dir is still where they live, and the docs
  # sweep reads them (DOCS_REPOS), so clone them here — a repo the sweep can't
  # open is a blind spot it reports as clean.
  #
  # 🚨 It goes at $ROOT/hausfold.co, and the full spelling is the point. The
  # directory is named for its repo, which is the rule §3.1 settled. Shorten it
  # and you land on a name the workshop already uses for something else — until
  # §10 that was `$ROOT/hausfold`, the platform checkout itself, and planting
  # the site there made `local_src` resolve the layer to a folder of HTML:
  # `bench try` builds the wrong tree and reports success.
  # This dir held a stale `hausfold/website` clone until 2026-08-09; it was
  # deleted, and nothing should recreate it.
  #
  # The remote comes from gh_repo like everyone else's, so `hausfold.co` resolves
  # to `hausfold/hausfold.co` — PUBLIC as of 2026-08-08. It was the private
  # `hausfold/website` until then; that repo is archived and stays private forever
  # (its history carries the name register and a Cloudflare account id, and PR
  # refs survive any scrub — hausfold-rename.md §5.1). Never add a gh_repo arm
  # pointing this name back at `website`: you'd clone a dead snapshot over the
  # live site.
  for name in trill hausfold.co; do
    local dir; dir="$(repo_dir "$name")"
    if [ -d "$dir/.git" ]; then
      say "$name already here"
    else
      say "cloning ${name}…"
      # Warn rather than die: a missing non-flake checkout shouldn't fail a
      # bootstrap whose real job is the family.
      git clone "https://github.com/$(gh_repo "$name").git" "$dir" \
        || warn "$name: clone failed — check your network"
    fi
  done
}

# When sourced with HAUS_LIB=1 (the bats test harness), stop here: the caller
# just wants the functions above, not to dispatch a command.
if [ "${HAUS_LIB:-}" != "1" ]; then
case "${1:-status}" in
  status)  cmd_status ;;
  try)     shift; cmd_try "$@" ;;
  try-batch) shift; cmd_try_batch "$@" ;;
  ship)    cmd_ship ;;
  rebuild) cmd_rebuild ;;
  pull)    shift; cmd_pull "$@" ;;
  clone)   cmd_clone ;;
  docs-since) cmd_docs_since "${2:-}" ;;
  release) shift; cmd_release "$@" ;;
  *)       sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
fi
