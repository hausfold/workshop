# The family repos live inside this dir but are their own git repos.
#
# ⚠️ Two of these are one dot apart: `haus/` is the PLATFORM checkout
# (`hausfold/haus`, renamed there 2026-08-11) and `hausfold.co/` is the SITE
# (`hausfold/hausfold.co`, not in FAMILY). Two different repos; each directory
# is named for its own. A pre-rename spelling reappearing here means something
# re-cloned the layer under a name `bench` will not find.
/haus/
/hausfold.co/
/homebrew-tap/
/holt/
/nebelung/
/pounce/
/perch/
/ops/
/org-profile/
/trill/
# `ops` is private and NOT in bench's FAMILY, DOCS_REPOS or clone list — it is
# cloned by hand when name-register work needs it, so most machines won't have
# it. The line is here anyway: without it, the one clone that does happen leaves
# `?? ops/` in this tree and a `git add -A` up here tries to add a nested repo.
# That is exactly the trap #283 left behind with `messages/`; don't wait for it.
/ops/
/web/.wrangler/
.DS_Store

# vitest writes its cache to the REPO ROOT when run from here (web/.gitignore
# only covers web/node_modules), and a tracked cache file makes this tree
# permanently dirty — which `bench ship` refuses and `bench status` cries wolf on.
/node_modules/
